{
  "schema": "21kb.agent-exam/v1",
  "title": "Core requests in Polish, first set",
  "tasks": [
    {
      "id": "material_on_object", "area": "materials", "tags": ["material", "look"], "template": "Basic3D",
      "setup": [["entity", "add", "--name", "Skrzynia", "--create", "Cube", "--position", "0,1,0"]],
      "requests": ["Zrób zielony materiał i nałóż go na skrzynię."],
      "checks": [
        {"check": "files", "glob": "Assets/**/*.kbmat", "contains": "baseColor\\s+([0-9.]+)\\s+([0-9.]+)\\s+([0-9.]+)", "expr": "g2 > g1 + 0.2 and g2 > g3 + 0.2", "label": "a green material"},
        {"check": "entity_show", "name": "Skrzynia", "regex": "material=/Game/", "label": "on the crate"}
      ]
    },
    {
      "id": "add_physics", "area": "physics", "tags": ["physics", "component"], "template": "Basic3D",
      "setup": [["entity", "add", "--name", "Skrzynia", "--create", "Cube", "--position", "0,3,0"]],
      "requests": ["Niech skrzynia spada na podłogę, jak prawdziwy przedmiot. Dodaj jej fizykę."],
      "checks": [
        {"check": "entity_show", "name": "Skrzynia", "component": "Rigidbody", "regex": "bodyType=Dynamic", "label": "the crate is a dynamic body"}
      ]
    },
    {
      "id": "prefab_component", "area": "prefabs", "tags": ["prefab", "component"], "template": "Basic3D",
      "setup": [["entity", "add", "--name", "Skrzynia", "--create", "Cube", "--position", "0,1,0"]],
      "requests": ["Zrób ze skrzyni prefab o nazwie SkrzyniaPrefab i dodaj do tego prefabu fizykę."],
      "checks": [
        {"check": "files", "glob": "Assets/**/SkrzyniaPrefab.kbprefab", "label": "a prefab with that name"},
        {"check": "files", "glob": "Assets/**/SkrzyniaPrefab.kbprefab", "contains": "rigidbody", "label": "that has physics"}
      ]
    },
    {
      "id": "rotate_script", "area": "scripts", "tags": ["script"], "template": "Basic3D",
      "setup": [["entity", "add", "--name", "Skrzynia", "--create", "Cube", "--position", "0,1,0"]],
      "requests": ["Ta skrzynia na scenie ma cały czas powoli kręcić się wokół własnej osi."],
      "checks": [
        {"check": "files", "glob": "Assets/**/*.lua", "contains": "rotat|euler|Transform", "label": "a new script that turns something"},
        {"check": "entity_show", "name": "Skrzynia", "regex": "Behaviour: script=/Game/[^ ]*\\.lua", "label": "attached to the crate"},
        {"check": "run", "frames": 60}
      ]
    },
    {
      "id": "evening_light", "area": "lights and mood", "tags": ["light", "look"], "template": "Basic3D",
      "requests": ["Niech będzie wieczór: ciepłe, pomarańczowe światło słońca."],
      "checks": [
        {"check": "entity_show", "component": "Light", "regex": "kind=Directional color=([0-9.]+),([0-9.]+),([0-9.]+)", "expr": "g1 > g3 + 0.15", "label": "the sun gets a warm colour"}
      ]
    },
    {
      "id": "game_name", "area": "game settings", "tags": ["settings"], "template": "Basic3D",
      "requests": ["Nazwij moją grę Smocze Wzgórza."],
      "checks": [
        {"check": "setting", "key": "Identity.GameName", "regex": "Smocze Wz", "label": "the game's name"}
      ]
    },
    {
      "id": "ui_button", "area": "UI", "tags": ["ui"], "template": "Basic3D",
      "requests": ["Dodaj na ekran gry przycisk z napisem Graj."],
      "checks": [
        {"check": "scene_entities", "component": "Button", "label": "a button"},
        {"check": "entity_show", "component": "Text", "regex": "Graj", "label": "with the text Graj"},
        {"check": "validate"}
      ]
    },
    {
      "id": "walking_character", "area": "3D character", "tags": ["character", "3d"], "template": "Basic3D",
      "requests": ["Dodaj postać, którą mogę chodzić po scenie, z kamerą za nią."],
      "checks": [
        {"check": "scene_entities", "component": "CharacterController", "label": "a walking character"},
        {"check": "scene_entities", "behaviour": "Character", "label": "with a controller script"},
        {"check": "run", "frames": 60}
      ]
    },
    {
      "id": "neon_heart_icon", "area": "art", "tags": ["art", "ui"], "template": "Basic3D",
      "requests": ["Zrób neonową ikonę serca i postaw ją jako obrazek w interfejsie."],
      "checks": [
        {"check": "files", "glob": "Assets/**/*.png", "magic": "89504e470d0a1a0a", "min_bytes": 500, "non_blank_picture": true,
         "label": "a new PNG picture inside Assets"},
        {"check": "entity_show", "component": "Image", "regex": "imageAssetId=/Game/\\S+\\.(png|21kb)", "label": "a UI Image that shows it"},
        {"check": "validate"}
      ]
    },
    {
      "id": "jump_sound", "area": "sound", "tags": ["sound", "art"], "template": "Basic3D",
      "requests": ["Dodaj dźwięk skoku do projektu."],
      "checks": [
        {"check": "files", "glob": "Assets/**/*.wav", "magic": "52494646", "min_bytes": 2000, "label": "a new WAV sound inside Assets"}
      ]
    },
    {
      "id": "intro_camera_flight", "area": "cinematic", "tags": ["timeline", "cinematic"], "template": "Basic3D",
      "setup": [["entity", "add", "--create", "Third Person Player"]],
      "requests": ["Zrób krótkie intro: kamera przelatuje do gracza przez 3 sekundy na starcie sceny"],
      "checks": [
        {"check": "files", "glob": "Assets/**/*.kbtimeline", "contains": "(?s)duration 3\\b.*transform \"[^\"]*\" 0 (\\S+) (\\S+) (\\S+) .*transform \"[^\"]*\" 3 (\\S+) (\\S+) (\\S+) ",
         "expr": "abs(g1 - g4) + abs(g2 - g5) + abs(g3 - g6) > 0.5",
         "label": "a 3 second timeline whose object really moves between the start and the end"},
        {"check": "files", "glob": "Assets/**/*.lua", "contains": "Timeline\\.Play", "label": "a script that plays it"},
        {"check": "run", "frames": 200}
      ]
    },
    {
      "id": "dark_orange_ui", "area": "UI look", "tags": ["ui", "theme"], "template": "Basic3D",
      "setup": [["entity", "add", "--create", "Button", "--name", "Graj"],
                ["component", "set", "--entity", "Graj", "--type", "Text", "--set", "content=Graj"],
                ["entity", "add", "--create", "Button", "--name", "Wyjscie"],
                ["component", "set", "--entity", "Wyjscie", "--type", "Text", "--set", "content=Wyjscie"]],
      "requests": ["Zmień wygląd interfejsu na ciemny z pomarańczowymi przyciskami"],
      "checks": [
        {"check": "files", "glob": "Assets/**/*.kbtheme", "contains": "backgroundColor\\.r\" 3 0\\.[0-2]\\S*\\s+\"[^\"]*\" \"backgroundColor\\.g\" 3 0\\.[0-2]\\S*\\s+\"[^\"]*\" \"backgroundColor\\.b\" 3 0\\.[0-3]", "label": "a theme with a dark background"},
        {"check": "files", "glob": "Assets/**/*.kbtheme", "contains": "backgroundColor\\.r\" 3 (0\\.[7-9]\\S*|1)\\s+\"[^\"]*\" \"backgroundColor\\.g\" 3 0\\.[3-7]\\S*\\s+\"[^\"]*\" \"backgroundColor\\.b\" 3 0\\.[0-3]", "label": "a theme with orange buttons"},
        {"check": "entity_show", "name": "Graj", "component": "Rect Transform", "regex": "themeAssetId=/Game/\\S+\\.kbtheme", "label": "the buttons use the theme"},
        {"check": "validate"}
      ]
    },
    {
      "id": "translate_texts", "area": "localization", "tags": ["localization", "ui"], "template": "Basic3D",
      "setup": [["entity", "add", "--create", "Button", "--name", "NowaGra"],
                ["component", "set", "--entity", "NowaGra", "--type", "Text", "--set", "content=Nowa gra"],
                ["entity", "add", "--create", "Text", "--name", "Tytul"],
                ["component", "set", "--entity", "Tytul", "--type", "Text", "--set", "content=Smocze Wzgorza"]],
      "requests": ["Dodaj angielską i niemiecką wersję tekstów gry"],
      "checks": [
        {"check": "files", "glob": "Assets/**/*.kbloc", "contains": "language \"en\"(?s:.*)\"[^\"\\n]*new game", "label": "an English version, translated"},
        {"check": "files", "glob": "Assets/**/*.kbloc", "contains": "language \"de\"(?s:.*)\"[^\"\\n]*(neues spiel|neu)", "label": "a German version, translated"},
        {"check": "entity_show", "name": "NowaGra", "component": "Text", "regex": "localizationKey=[a-z]", "label": "the button text uses a key"},
        {"check": "files", "glob": "Assets/**/*.lua", "contains": "Localization\\.SetCatalog", "label": "a script that gives the game its catalog"},
        {"check": "run", "frames": 30}
      ]
    },
    {
      "id": "coin_bob_spin",
      "area": "animation",
      "tags": [
        "animation"
      ],
      "template": "Basic3D",
      "setup": [
        [
          "entity",
          "add",
          "--create",
          "Cylinder",
          "--name",
          "Moneta",
          "--position",
          "0,1.5,3",
          "--scale",
          "1,0.1,1",
          "--color",
          "#F5B921"
        ]
      ],
      "requests": [
        "Niech moneta na scenie unosi się w górę i w dół i obraca w kółko"
      ],
      "checks": [
        {
          "check": "files",
          "glob": "Assets/**/*.kbanim",
          "contains": "looping 1(?s:.*?)track \"\\.\" \\d+\\s+(?:key [^\\n]*\\n)*?key \\d+ (\\S+) (\\S+) (\\S+) (\\S+) (\\S+) (\\S+) (\\S+) (\\S+) (\\S+) (\\S+) (\\S+)\\s+key \\d+ (\\S+) (\\S+) (\\S+) (\\S+) (\\S+) (\\S+) (\\S+) (\\S+) (\\S+) (\\S+) (\\S+)\\s+key \\d+ (\\S+) (\\S+) (\\S+) (\\S+) (\\S+) (\\S+) (\\S+) (\\S+) (\\S+) (\\S+) (\\S+)\\s+",
          "expr": "max(g3, g14, g25) - min(g3, g14, g25) > 0.05 and (max(g5, g16, g27) - min(g5, g16, g27) > 0.05 or max(g6, g17, g28) - min(g6, g17, g28) > 0.05 or max(g7, g18, g29) - min(g7, g18, g29) > 0.05 or max(g8, g19, g30) - min(g8, g19, g30) > 0.05)",
          "label": "a looping clip of the coin whose height and rotation both change over three keys in a row"
        },
        {
          "check": "files",
          "glob": "Assets/**/*.kbanimcontroller",
          "contains": "state \\d+ \\d+ \"[^\"]*\" \"/Game/[^\"]+\\.kbanim\"",
          "label": "a controller that plays the clip"
        },
        {
          "check": "entity_show",
          "name": "Moneta",
          "component": "Animator",
          "regex": "controllerAssetId=/Game/\\S+\\.kbanimcontroller",
          "label": "the coin has an Animator with that controller"
        },
        {
          "check": "run",
          "frames": 240
        }
      ]
    },
    {
      "id": "glow_edge_function",
      "area": "material function",
      "tags": [
        "material",
        "function"
      ],
      "template": "Basic3D",
      "setup": [
        [
          "entity",
          "add",
          "--create",
          "Sphere",
          "--name",
          "Kula",
          "--position",
          "0,1,3",
          "--color",
          "#2E86DE"
        ]
      ],
      "requests": [
        "Zrób efekt świecącej krawędzi jako funkcję materiału i użyj go w materiale kuli"
      ],
      "checks": [
        {
          "check": "files",
          "glob": "Assets/**/*.kbmatfn",
          "contains": "(?s)graphNode \\d+ FunctionOutput.*graphNode \\d+ Fresnel|graphNode \\d+ Fresnel.*graphNode \\d+ FunctionOutput",
          "label": "a new material function with a Fresnel edge and an output"
        },
        {
          "check": "files",
          "glob": "Assets/**/*.kbmat",
          "contains": "(?s)graphNode \\d+ MaterialFunctionCall.*graphLink \\d+ \\d+ \\d+ \\S+ \\d+ \\d+ emissive",
          "label": "a material that calls a function and sends it to Emissive"
        },
        {
          "check": "cli",
          "args": [
            "material-graph",
            "show",
            "--material",
            "/Game/Materials/Kula.kbmat"
          ],
          "output_matches": [
            "MaterialFunctionCall",
            "Compiles: yes"
          ],
          "label": "the ball's material calls the function and compiles"
        },
        {
          "check": "validate"
        }
      ]
    }
  ]
}
