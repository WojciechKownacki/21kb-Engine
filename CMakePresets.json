{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 27,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ecs-benchmarks-release",
      "displayName": "ECS Benchmarks Release",
      "description": "Configure only the ECS benchmark runtime without editor, renderer, or tests.",
      "binaryDir": "${sourceDir}/build/ecs-benchmarks-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "KB_BUILD_EDITOR": "OFF",
        "KB_BUILD_RENDERER": "OFF",
        "KB_ECS_BENCHMARKS_ENABLE_LTO": "OFF",
        "KB_ECS_BENCHMARKS_PGO_MODE": "Off"
      }
    },
    {
      "name": "ecs-benchmarks-lto",
      "displayName": "ECS Benchmarks LTO",
      "description": "Configure ECS benchmarks with target-local link-time optimization.",
      "inherits": "ecs-benchmarks-release",
      "binaryDir": "${sourceDir}/build/ecs-benchmarks-lto",
      "cacheVariables": {
        "KB_ECS_BENCHMARKS_ENABLE_LTO": "ON"
      }
    },
    {
      "name": "ecs-benchmarks-pgo-generate",
      "displayName": "ECS Benchmarks PGO Generate",
      "description": "Configure instrumented ECS benchmarks that generate profile data.",
      "inherits": "ecs-benchmarks-release",
      "binaryDir": "${sourceDir}/build/ecs-benchmarks-pgo-generate",
      "cacheVariables": {
        "KB_ECS_BENCHMARKS_ENABLE_LTO": "ON",
        "KB_ECS_BENCHMARKS_PGO_MODE": "Generate",
        "KB_ECS_BENCHMARKS_PGO_PROFILE_DIR": "${sourceDir}/build/ecs-benchmarks-pgo-profile"
      }
    },
    {
      "name": "ecs-benchmarks-pgo-use",
      "displayName": "ECS Benchmarks PGO Use",
      "description": "Configure optimized ECS benchmarks that consume generated profile data.",
      "inherits": "ecs-benchmarks-release",
      "binaryDir": "${sourceDir}/build/ecs-benchmarks-pgo-use",
      "cacheVariables": {
        "KB_ECS_BENCHMARKS_ENABLE_LTO": "ON",
        "KB_ECS_BENCHMARKS_PGO_MODE": "Use",
        "KB_ECS_BENCHMARKS_PGO_PROFILE_DIR": "${sourceDir}/build/ecs-benchmarks-pgo-profile"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ecs-benchmarks-release",
      "displayName": "Build ECS Benchmarks Release",
      "configurePreset": "ecs-benchmarks-release",
      "configuration": "Release",
      "targets": [
        "kb_ecs_benchmarks"
      ]
    },
    {
      "name": "ecs-benchmarks-lto-release",
      "displayName": "Build ECS Benchmarks LTO Release",
      "configurePreset": "ecs-benchmarks-lto",
      "configuration": "Release",
      "targets": [
        "kb_ecs_benchmarks"
      ]
    },
    {
      "name": "ecs-benchmarks-pgo-generate-release",
      "displayName": "Build ECS Benchmarks PGO Generate Release",
      "configurePreset": "ecs-benchmarks-pgo-generate",
      "configuration": "Release",
      "targets": [
        "kb_ecs_benchmarks"
      ]
    },
    {
      "name": "ecs-benchmarks-pgo-train-release",
      "displayName": "Run ECS Benchmarks PGO Training Release",
      "configurePreset": "ecs-benchmarks-pgo-generate",
      "configuration": "Release",
      "targets": [
        "kb_ecs_benchmarks_pgo_train"
      ]
    },
    {
      "name": "ecs-benchmarks-pgo-use-release",
      "displayName": "Build ECS Benchmarks PGO Use Release",
      "configurePreset": "ecs-benchmarks-pgo-use",
      "configuration": "Release",
      "targets": [
        "kb_ecs_benchmarks"
      ]
    }
  ]
}
