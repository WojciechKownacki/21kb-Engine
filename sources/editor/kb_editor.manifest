<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The editor runs with UTF-8 as its code page (Windows 10 1903+): its text is UTF-8 everywhere,
     so the interface in any of its 33 languages, and file and object names in any letters, reach
     the narrow Win32 and GDI calls intact. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
