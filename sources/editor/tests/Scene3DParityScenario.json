{
  "schema": "21kb.editor-automation/v1",
  "steps": [
    { "op": "configure_runtime_rendering", "width": 960, "height": 540 },
    { "op": "create_scene", "name": "Parity3D", "template": "Empty" },

    { "op": "create_entity", "id": "cam", "name": "Cam", "preset": "Camera" },
    { "op": "set_property", "entity": "cam", "component": "Camera", "property": "primary", "value": true },
    { "op": "set_entity_position", "entity": "cam", "x": 0.0, "y": 3.2, "z": -8.5 },
    { "op": "set_property", "entity": "cam", "component": "Transform", "property": "localRotation.x", "value": 0.12187 },
    { "op": "set_property", "entity": "cam", "component": "Transform", "property": "localRotation.w", "value": 0.99255 },

    { "op": "create_entity", "id": "sun", "name": "Sun", "preset": "Directional Light" },
    { "op": "set_property", "entity": "sun", "component": "Transform", "property": "localRotation.x", "value": 0.39098 },
    { "op": "set_property", "entity": "sun", "component": "Transform", "property": "localRotation.y", "value": -0.25181 },
    { "op": "set_property", "entity": "sun", "component": "Transform", "property": "localRotation.z", "value": 0.11211 },
    { "op": "set_property", "entity": "sun", "component": "Transform", "property": "localRotation.w", "value": 0.87816 },
    { "op": "create_entity", "id": "env", "name": "Environment", "preset": "Environment" },
    { "op": "create_entity", "id": "lamp", "name": "Lamp", "preset": "Point Light" },
    { "op": "set_entity_position", "entity": "lamp", "x": -1.5, "y": 2.2, "z": -1.5 },
    { "op": "set_property", "entity": "lamp", "component": "Light", "property": "range", "value": 9.0 },
    { "op": "set_property", "entity": "lamp", "component": "Light", "property": "intensity", "value": 30.0 },

    { "op": "create_entity", "id": "floor", "name": "Floor", "preset": "Plane" },
    { "op": "create_entity", "id": "cube", "name": "Cube", "preset": "Cube" },
    { "op": "set_entity_position", "entity": "cube", "x": -2.2, "y": 0.5, "z": 0.0 },
    { "op": "create_entity", "id": "ball", "name": "Ball", "preset": "Sphere" },
    { "op": "set_entity_position", "entity": "ball", "x": 0.0, "y": 0.5, "z": 0.5 },
    { "op": "create_entity", "id": "pillar", "name": "Pillar", "preset": "Capsule" },
    { "op": "set_entity_position", "entity": "pillar", "x": 2.2, "y": 1.0, "z": 0.0 },

    { "op": "create_asset", "id": "shiny", "type": "material", "folder": "/Game/Materials" },
    { "op": "set_material", "asset": "shiny", "property": "metallic", "value": 0.9 },
    { "op": "set_material", "asset": "shiny", "property": "roughness", "value": 0.25 },
    { "op": "save_material", "asset": "shiny" },
    { "op": "assign_asset", "entity": "ball", "asset": "shiny", "role": "material" },
    { "op": "create_asset", "id": "glow", "type": "material", "folder": "/Game/Materials" },
    { "op": "set_material", "asset": "glow", "property": "emissive_strength", "value": 2.5 },
    { "op": "set_material", "asset": "glow", "property": "roughness", "value": 0.6 },
    { "op": "save_material", "asset": "glow" },
    { "op": "assign_asset", "entity": "pillar", "asset": "glow", "role": "material" },

    { "op": "create_asset", "id": "look", "type": "post_process_profile", "folder": "/Game" },
    { "op": "post_process_row", "asset": "look", "field": "antiAliasing" },
    { "op": "post_process_row", "asset": "look", "field": "vignetteEnabled" },
    { "op": "post_process_row", "asset": "look", "field": "vignetteIntensity", "text": "0.4" },
    { "op": "post_process_row", "asset": "look", "field": "fogEnabled" },
    { "op": "post_process_row", "asset": "look", "field": "fogDensity", "text": "0.03" },
    { "op": "post_process_row", "asset": "look", "field": "ambientOcclusionEnabled" },
    { "op": "assert_post_process_profile", "asset": "look", "field": "fogEnabled", "value": "1" },
    { "op": "assert_post_process_profile", "asset": "look", "field": "fxaaEnabled", "value": "1" },
    { "op": "set_scene_post_process_profile", "asset": "look" },

    { "op": "create_asset", "id": "sparks", "type": "particle_effect", "folder": "/Game/Vfx" },
    { "op": "create_entity", "id": "fx", "name": "Sparks" },
    { "op": "add_component", "entity": "fx", "component": "Particle Effect" },
    { "op": "set_particle_effect_asset", "entity": "fx", "asset": "sparks" },
    { "op": "set_entity_position", "entity": "fx", "x": 0.0, "y": 1.6, "z": 0.2 },

    { "op": "set_plugin", "id": "Editor.Terrain", "enabled": true },
    { "op": "create_entity", "id": "ground", "name": "Hills" },
    { "op": "add_component", "entity": "ground", "component": "TerrainEditor" },
    { "op": "configure_terrain", "entity": "ground", "width": 65, "height": 65, "chunk_quads": 16, "lod_count": 3, "world_size_x": 64.0, "world_size_z": 64.0 },
    { "op": "terrain_stamp", "entity": "ground", "x": 6.0, "z": 12.0, "radius": 6.0, "strength": 3.0 },
    { "op": "set_entity_position", "entity": "ground", "x": -32.0, "y": -0.05, "z": -20.0 },

    { "op": "set_plugin", "id": "Editor.Terrain", "enabled": false },
    { "op": "save_scene" },
    { "op": "open_scene", "path": "Assets/Scenes/Parity3D.21kbscene" },
    { "op": "assert_component", "entity": "ball", "component": "MeshRenderer" },
    { "op": "set_startup_scene", "path": "/Game/Scenes/Parity3D.21kbscene" },
    { "op": "play" },
    { "op": "step", "frames": 240, "dt": 0.0166666667 },
    { "op": "capture_runtime", "checkpoint": "scene3d-editor", "require_non_uniform": true },
    { "op": "assert_no_errors" },
    { "op": "stop" },
    { "op": "assert_no_errors" }
  ]
}
