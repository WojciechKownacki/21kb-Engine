{
  "schema": "21kb.editor-automation/v1",
  "steps": [
    { "op": "new_scene" },
    {
      "op": "write_file",
      "path": "Assets/Meshes/Plate.obj",
      "content": "v -6 0 -6\nv 6 0 -6\nv 6 0 6\nv -6 0 6\nvn 0 1 0\nusemtl stone\nf 1//1 4//1 3//1\nf 1//1 3//1 2//1\n"
    },
    { "op": "discover_assets" },
    { "op": "create_entity", "id": "floor", "name": "Floor" },
    { "op": "set_entity_position", "entity": "floor", "x": 0, "y": -0.5, "z": 0 },
    { "op": "add_component", "entity": "floor", "component": "Collider" },
    { "op": "set_property", "entity": "floor", "component": "Collider", "property": "boxSize.x", "value": 20 },
    { "op": "set_property", "entity": "floor", "component": "Collider", "property": "boxSize.z", "value": 20 },
    { "op": "create_mesh_entity", "id": "plate", "asset": "/Game/Meshes/Plate.obj" },
    { "op": "set_entity_position", "entity": "plate", "x": 0, "y": 1, "z": 20 },
    { "op": "create_entity", "id": "jump", "name": "Jump" },
    { "op": "set_entity_position", "entity": "jump", "x": 0, "y": 0, "z": 9 },
    { "op": "add_component", "entity": "jump", "component": "NavLink" },
    { "op": "set_property", "entity": "jump", "component": "NavLink", "property": "end.y", "value": 1 },
    { "op": "set_property", "entity": "jump", "component": "NavLink", "property": "end.z", "value": 6 },
    { "op": "assert_property", "entity": "jump", "component": "NavLink", "property": "kind", "value": 0 },
    { "op": "save_scene", "path": "Assets/Scenes/Nav.21kbscene" },

    { "op": "navmesh_bake" },
    { "op": "assert_file", "path": "Assets/Scenes/Nav.21kbnavmesh", "min_size": 64 },
    { "op": "assert_navmesh", "path": "Assets/Scenes/Nav.21kbscene", "min_tiles": 2, "profiles": 1, "min_area": 400, "max_area": 520, "min_drawn_triangles": 4 },
    { "op": "assert_navmesh_matches_tools", "path": "Assets/Scenes/Nav.21kbscene" },
    { "op": "capture_scene_viewport", "checkpoint": "navmesh-shown" },
    { "op": "navmesh_set_visible", "visible": false },
    { "op": "capture_scene_viewport", "checkpoint": "navmesh-hidden" },
    { "op": "assert_capture_color_difference", "with": "navmesh-shown", "without": "navmesh-hidden", "color": [67, 122, 0], "tolerance": 30, "min_pixels": 20000 },
    { "op": "navmesh_set_visible", "visible": true },

    { "op": "write_file", "path": "Assets/Meshes/Cover.obj",
      "content": "v -100 0 -100\nv 100 0 -100\nv 100 0 100\nv -100 0 100\nvn 0 1 0\nusemtl stone\nf 1//1 4//1 3//1\nf 1//1 3//1 2//1\n" },
    { "op": "discover_assets" },
    { "op": "create_mesh_entity", "id": "cover", "asset": "/Game/Meshes/Cover.obj" },
    { "op": "set_entity_position", "entity": "cover", "x": 0, "y": 3, "z": 0 },
    { "op": "add_component", "entity": "cover", "component": "Rigidbody" },
    { "op": "set_property", "entity": "cover", "component": "Rigidbody", "property": "bodyType", "value": 2 },
    { "op": "capture_scene_viewport", "checkpoint": "navmesh-covered" },
    { "op": "navmesh_set_visible", "visible": false },
    { "op": "capture_scene_viewport", "checkpoint": "navmesh-covered-hidden" },
    { "op": "assert_capture_color_difference", "with": "navmesh-covered", "without": "navmesh-covered-hidden", "color": [67, 122, 0], "tolerance": 30, "min_pixels": 0, "max_pixels": 200 },
    { "op": "navmesh_set_visible", "visible": true },
    { "op": "delete_entity", "entity": "cover" },

    { "op": "create_entity", "id": "block", "name": "Block" },
    { "op": "set_entity_position", "entity": "block", "x": 5, "y": 1, "z": -5 },
    { "op": "add_component", "entity": "block", "component": "Collider" },
    { "op": "set_property", "entity": "block", "component": "Collider", "property": "boxSize.x", "value": 2 },
    { "op": "set_property", "entity": "block", "component": "Collider", "property": "boxSize.y", "value": 2 },
    { "op": "set_property", "entity": "block", "component": "Collider", "property": "boxSize.z", "value": 2 },
    { "op": "navmesh_wait_update" },
    { "op": "save_scene" },
    { "op": "assert_navmesh_matches_tools", "path": "Assets/Scenes/Nav.21kbscene" },

    { "op": "navigation_inspector_click", "entity": "block", "row": "collider_affects_navigation" },
    { "op": "assert_property", "entity": "block", "component": "Collider", "property": "affectsNavigation", "value": false },
    { "op": "navmesh_wait_update" },
    { "op": "save_scene" },
    { "op": "assert_navmesh_matches_tools", "path": "Assets/Scenes/Nav.21kbscene" },
    { "op": "navigation_inspector_click", "entity": "plate", "row": "mesh_affects_navigation" },
    { "op": "assert_property", "entity": "plate", "component": "MeshRenderer", "property": "affectsNavigation", "value": false },
    { "op": "navmesh_wait_update" },
    { "op": "assert_navmesh", "path": "Assets/Scenes/Nav.21kbscene", "min_tiles": 1, "profiles": 1, "min_area": 300, "max_area": 390 },
    { "op": "navigation_inspector_click", "entity": "plate", "row": "mesh_affects_navigation" },
    { "op": "assert_property", "entity": "plate", "component": "MeshRenderer", "property": "affectsNavigation", "value": true },
    { "op": "navmesh_wait_update" },
    { "op": "assert_navmesh", "path": "Assets/Scenes/Nav.21kbscene", "min_tiles": 2, "profiles": 1, "min_area": 400, "max_area": 520 },

    { "op": "create_entity", "id": "puddle", "name": "Puddle" },
    { "op": "add_component", "entity": "puddle", "component": "NavObstacle" },
    { "op": "navigation_inspector_click", "entity": "puddle", "row": "obstacle_area" },
    { "op": "navigation_inspector_click", "entity": "puddle", "row": "obstacle_area", "index": 3, "expect": 3 },
    { "op": "delete_entity", "entity": "puddle" },

    { "op": "assert_navigation_area", "index": 0, "count": 5, "name": "Walkable", "colour": 9240320, "overlay": true },
    { "op": "navigation_settings_click", "target": "colour", "index": 0 },
    { "op": "assert_navigation_area", "index": 0, "colour": 11579568, "overlay": true },
    { "op": "navigation_settings_click", "target": "cost", "index": 3, "text": "7.5" },
    { "op": "assert_navigation_area", "index": 3, "name": "Water", "cost": 7.5 },
    { "op": "navigation_settings_click", "target": "new", "text": "Lava" },
    { "op": "assert_navigation_area", "index": 5, "count": 6, "name": "Lava", "cost": 1 },
    { "op": "navigation_settings_click", "target": "name", "index": 5, "text": "Mud" },
    { "op": "assert_navigation_area", "index": 5, "count": 6, "name": "Mud" },
    { "op": "navigation_settings_click", "target": "remove", "index": 2 },
    { "op": "assert_navigation_area", "index": 5, "count": 6, "name": "Mud" },
    { "op": "navigation_settings_click", "target": "remove", "index": 5 },
    { "op": "assert_navigation_area", "index": 4, "count": 5, "name": "Not walkable", "cost": 0 },

    { "op": "create_entity", "id": "agent", "name": "Agent" },
    { "op": "set_entity_position", "entity": "agent", "x": 0, "y": 0, "z": -6 },
    { "op": "add_component", "entity": "agent", "component": "NavAgent" },
    { "op": "set_property", "entity": "agent", "component": "NavAgent", "property": "destination.y", "value": 1 },
    { "op": "set_property", "entity": "agent", "component": "NavAgent", "property": "destination.z", "value": 20 },
    { "op": "navigation_inspector_click", "entity": "agent", "row": "agent_areas" },
    { "op": "navigation_inspector_click", "entity": "agent", "row": "agent_areas", "index": 1, "expect": 4294967293 },
    { "op": "assert_property", "entity": "agent", "component": "NavAgent", "property": "areaMask", "value": -3 },
    { "op": "save_scene" },
    { "op": "play" },
    { "op": "assert_agent_reaches", "entity": "agent", "x": 0, "z": 20, "tolerance": 0.3, "timeout_ms": 30000 },
    { "op": "stop" },
    { "op": "assert_no_errors" }
  ]
}
