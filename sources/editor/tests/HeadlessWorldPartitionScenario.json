{
  "schema": "21kb.editor-automation/v1",
  "steps": [
    { "op": "new_scene" },
    {
      "op": "write_file",
      "path": "Assets/Meshes/Rock.obj",
      "content": "v 0 0 0\nv 1 0 0\nv 1 1 0\nv 0 1 0\nvt 0 0\nvt 1 0\nvt 1 1\nvt 0 1\nvn 0 0 1\nusemtl stone\nf 1/1/1 2/2/1 3/3/1\nf 1/1/1 3/3/1 4/4/1\n"
    },
    { "op": "discover_assets" },
    { "op": "create_mesh_entity", "id": "boulder", "asset": "/Game/Meshes/Rock.obj" },
    { "op": "rename_entity", "entity": "boulder", "name": "Boulder" },
    { "op": "set_entity_position", "entity": "boulder", "x": 20, "y": 0, "z": 20 },
    { "op": "create_entity", "id": "rockA", "name": "RockA" },
    { "op": "set_entity_position", "entity": "rockA", "x": 10, "y": 0, "z": 10 },
    { "op": "create_entity", "id": "rockB", "name": "RockB" },
    { "op": "set_entity_position", "entity": "rockB", "x": 300, "y": 0, "z": 10 },
    { "op": "create_entity", "id": "rockC", "name": "RockC" },
    { "op": "set_entity_position", "entity": "rockC", "x": 700, "y": 0, "z": 10 },
    { "op": "save_scene", "path": "Assets/Scenes/Level.21kbscene" },

    { "op": "world_convert_scene", "cell_size": 128 },
    { "op": "assert_file", "path": "Assets/Scenes/Level.21kbworld", "contains": "21kb.world/v1" },
    { "op": "assert_file", "path": "Assets/Scenes/Level.21kbscene", "min_size": 64 },
    { "op": "assert_world", "loaded_objects": 0, "loaded_cells": 0, "occupied_cells": 3, "object_files": 4, "grid_lines": 12 },

    { "op": "world_load_region", "min_x": 0, "min_z": 0, "max_x": 2, "max_z": 0 },
    { "op": "assert_world", "loaded_objects": 3, "loaded_cells": 2, "grid_lines": 12 },
    { "op": "world_bind_object", "id": "a", "name": "RockA" },
    { "op": "set_entity_position", "entity": "a", "x": 40, "y": 0, "z": 20 },
    { "op": "world_unload_region", "min_x": 0, "min_z": 0, "max_x": 0, "max_z": 0 },
    { "op": "assert_world", "loaded_objects": 1, "loaded_cells": 1 },
    { "op": "assert_world_object", "name": "RockA", "loaded": false, "x": 40, "z": 20 },

    { "op": "world_load_region", "min_x": 5, "min_z": 0, "max_x": 5, "max_z": 0 },
    { "op": "world_bind_object", "id": "c", "name": "RockC" },
    { "op": "world_declare_data_layer", "name": "night", "initially_active": false },
    { "op": "world_cycle_layer", "entity": "c" },
    { "op": "assert_world_object", "entity": "c", "layer": "night" },
    { "op": "world_bind_object", "id": "b", "name": "RockB" },
    { "op": "world_toggle_always_loaded", "entity": "b" },
    { "op": "assert_world_object", "entity": "b", "always_loaded": true },
    { "op": "save_scene" },
    { "op": "assert_file", "path": "Assets/Scenes/Level.21kbworld", "contains": "\"night\", \"initiallyActive\": false" },
    { "op": "assert_world", "object_files": 4 },

    { "op": "world_unload_all" },
    { "op": "assert_world", "loaded_objects": 1, "loaded_cells": 0 },
    { "op": "world_load_all" },
    { "op": "assert_world", "loaded_objects": 4 },
    { "op": "assert_world_object", "name": "RockA", "loaded": true, "x": 40, "z": 20 },
    { "op": "world_set_grid_visible", "visible": false },
    { "op": "assert_world", "grid_lines": 0 },
    { "op": "world_set_grid_visible", "visible": true },
    { "op": "assert_world", "grid_lines": 8 },

    { "op": "world_build" },
    { "op": "assert_world_build", "path": "Assets/Scenes/Level.21kbworld", "cells": 3, "hlods": 1, "persistent": 1, "layered": 1 },
    { "op": "assert_world_build_matches_tools", "path": "Assets/Scenes/Level.21kbworld" },
    { "op": "assert_file", "path": "Assets/Scenes/Level.cells/Level.21kbcells", "contains": "21kb.world-cells/v1" },
    { "op": "assert_file", "path": "Assets/Scenes/Level.cells/hlod/h_0_0.obj", "contains": "usemtl slot0" },

    { "op": "new_scene" },
    { "op": "assert_world", "open": false },
    { "op": "create_entity", "id": "host", "name": "WorldHost" },
    { "op": "add_component", "entity": "host", "component": "ContentInstance" },
    { "op": "assign_world", "entity": "host", "world": "/Game/Scenes/Level.21kbworld" },
    { "op": "create_entity", "id": "player", "name": "Player" },
    { "op": "set_entity_position", "entity": "player", "x": 30, "y": 0, "z": 30 },
    { "op": "add_component", "entity": "player", "component": "StreamFocus" },
    { "op": "set_property", "entity": "player", "component": "StreamFocus", "property": "outerRadius", "value": 120 },
    { "op": "set_property", "entity": "player", "component": "StreamFocus", "property": "innerRadius", "value": 90 },
    { "op": "save_scene", "path": "Assets/Scenes/Main.21kbscene" },
    { "op": "play" },
    { "op": "assert_world_cell", "entity": "host", "x": 0, "z": 0, "state": "loaded", "hlod_visible": false, "timeout_ms": 20000 },
    { "op": "assert_world_cell", "entity": "host", "persistent": true, "state": "loaded", "timeout_ms": 20000 },
    { "op": "assert_world_cell", "entity": "host", "x": 5, "z": 0, "layer": "night", "state": "unloaded" },
    { "op": "assert_world_cell", "entity": "host", "x": 2, "z": 0, "state": "unloaded" },
    { "op": "stop" },
    { "op": "assert_world_cell", "entity": "host", "x": 0, "z": 0, "state": "unloaded" },

    { "op": "open_world", "path": "Assets/Scenes/Level.21kbworld" },
    { "op": "assert_world", "loaded_objects": 1 },
    { "op": "world_load_near_camera" },
    { "op": "assert_world", "loaded_objects": 3 },
    { "op": "assert_no_errors" }
  ]
}
