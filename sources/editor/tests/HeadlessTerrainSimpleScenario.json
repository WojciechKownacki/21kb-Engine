{
  "schema": "21kb.editor-automation/v1",
  "steps": [
    { "op": "create_scene", "name": "TerrainSimple", "template": "Empty" },
    { "op": "set_plugin", "id": "Editor.Terrain", "enabled": true },
    { "op": "create_entity", "id": "land", "name": "Land" },
    { "op": "select_entity", "entity": "land" },
    { "op": "add_component", "entity": "land", "component": "TerrainEditor" },
    { "op": "assert_terrain_layer_weight", "entity": "land", "x": 0.0, "z": 0.0, "layer": 0, "min": 0.99 },
    { "op": "assert_terrain_layer_weight", "entity": "land", "x": 0.0, "z": 0.0, "layer": 1, "max": 0.01 },
    { "op": "terrain_tool", "entity": "land", "tool": "sculpt" },
    { "op": "capture", "panel": "scene", "checkpoint": "terrain-bar-simple", "width": 1100, "height": 300, "text_fits": true },
    { "op": "terrain_tool", "entity": "land", "tool": "flatten" },
    { "op": "terrain_tool", "entity": "land", "tool": "paint", "cycle": 2 },
    { "op": "capture", "panel": "scene", "checkpoint": "terrain-bar-paint-auto", "width": 1100, "height": 300, "text_fits": true },
    { "op": "terrain_tool", "entity": "land", "tool": "none" },
    { "op": "capture_scene_viewport", "checkpoint": "terrain-slope-off" },
    { "op": "terrain_slope_overlay", "enabled": true },
    { "op": "capture_scene_viewport", "checkpoint": "terrain-slope-on" },
    { "op": "assert_capture_difference", "before": "terrain-slope-off", "after": "terrain-slope-on" },
    { "op": "terrain_slope_overlay", "enabled": false },
    { "op": "terrain_stamp", "entity": "land", "mode": "ramp", "x": -30.0, "z": 30.0, "to": "-20,30", "height": 0.0, "toHeight": 40.0, "radius": 3.0 },
    { "op": "terrain_paint", "entity": "land", "auto": true, "x": -30.0, "z": 30.0, "to_x": -20.0, "to_z": 30.0, "radius": 4.0 },
    { "op": "assert_terrain_layer_weight", "entity": "land", "x": -25.0, "z": 30.0, "layer": 1, "min": 0.99 },
    { "op": "assert_terrain_layer_weight", "entity": "land", "x": 30.0, "z": -30.0, "layer": 0, "min": 0.99 },
    { "op": "undo" },
    { "op": "undo" },
    { "op": "configure_terrain", "entity": "land", "width": 513, "height": 513, "chunk_quads": 32, "lod_count": 4, "world_size_x": 128.0, "world_size_z": 128.0 },
    { "op": "terrain_drawer", "drawer": "new_world" },
    { "op": "capture", "panel": "scene", "checkpoint": "terrain-new-world", "width": 1100, "height": 300, "text_fits": true },
    { "op": "assert_terrain_relief", "entity": "land", "min": 0.0, "max": 0.001 },
    { "op": "terrain_world_wizard", "entity": "land", "preset": "island", "character": 0.8, "seed": 4, "wait": false },
    { "op": "capture", "panel": "scene", "checkpoint": "terrain-new-world-running", "width": 1100, "height": 300, "text_fits": true },
    { "op": "terrain_job", "action": "wait" },
    { "op": "assert_terrain_relief", "entity": "land", "min": 10.0 },
    { "op": "undo" },
    { "op": "assert_terrain_relief", "entity": "land", "min": 0.0, "max": 0.001 },
    { "op": "redo" },
    { "op": "assert_terrain_relief", "entity": "land", "min": 10.0 },
    { "op": "terrain_world_wizard", "entity": "land", "preset": "mountains", "wait": false },
    { "op": "terrain_job", "action": "cancel" },
    { "op": "assert_terrain_relief", "entity": "land", "min": 10.0, "max": 60.0 },
    { "op": "terrain_erode", "entity": "land", "kind": "thermal" },
    { "op": "terrain_erode", "entity": "land", "kind": "hydraulic" },
    { "op": "undo" },
    { "op": "undo" },
    { "op": "assert_terrain_settings", "entity": "land", "splat_resolution": 512, "lod_pixel_error": 2.0, "collision_step": 1 },
    { "op": "terrain_drawer", "drawer": "advanced" },
    { "op": "capture", "panel": "scene", "checkpoint": "terrain-advanced", "width": 1100, "height": 300, "text_fits": true },
    { "op": "terrain_settings", "entity": "land", "splat_resolution": 1024, "lod_pixel_error": 3.5, "collision_step": 2 },
    { "op": "assert_terrain_settings", "entity": "land", "splat_resolution": 1024, "lod_pixel_error": 3.5, "collision_step": 2 },
    { "op": "assert_terrain_layer_weight", "entity": "land", "x": 0.0, "z": 0.0, "layer": 0, "min": 0.99 },
    { "op": "terrain_paint", "entity": "land", "layer": 1, "x": 20.0, "z": 20.0, "radius": 6.0 },
    { "op": "assert_terrain_layer_weight", "entity": "land", "x": 20.0, "z": 20.0, "layer": 1, "min": 0.9 },
    { "op": "capture", "panel": "scene", "checkpoint": "terrain-advanced-settings", "width": 1100, "height": 300, "text_fits": true },
    { "op": "terrain_drawer", "drawer": "new_world" },
    { "op": "capture", "panel": "scene", "checkpoint": "terrain-new-world-splat", "width": 1100, "height": 300, "text_fits": true },
    { "op": "undo" },
    { "op": "configure_terrain", "entity": "land", "width": 257, "height": 257, "chunk_quads": 32, "lod_count": 4, "world_size_x": 128.0, "world_size_z": 128.0 },
    { "op": "assert_terrain_settings", "entity": "land", "splat_resolution": 1024, "lod_pixel_error": 3.5, "collision_step": 2 },
    { "op": "undo" },
    { "op": "undo" },
    { "op": "assert_terrain_settings", "entity": "land", "splat_resolution": 512, "lod_pixel_error": 2.0, "collision_step": 1 },
    { "op": "terrain_drawer", "drawer": "none" }
  ]
}
