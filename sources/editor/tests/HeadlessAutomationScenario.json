{
  "schema": "21kb.editor-automation/v1",
  "steps": [
    { "op": "copy_fixture", "source": "HeadlessAutomationScenario.json", "destination": "Fixtures/ScenarioCopy.json" },
    { "op": "assert_file", "path": "Fixtures/ScenarioCopy.json", "min_size": 1024, "contains": "21kb.editor-automation/v1" },
    { "op": "create_entity", "id": "player", "name": "Player" },
    { "op": "select_entity", "entity": "player" },
    { "op": "add_component", "entity": "player", "component": "Rigidbody" },
    { "op": "set_property", "entity": "player", "component": "Rigidbody", "property": "mass", "value": 2.5 },
    { "op": "set_property", "entity": "player", "component": "Rigidbody", "property": "useGravity", "value": false },
    { "op": "add_component", "entity": "player", "component": "Collider" },
    { "op": "assert_component", "entity": "player", "component": "Collider" },
    { "op": "undo" },
    { "op": "assert_component", "entity": "player", "component": "Collider", "exists": false },
    { "op": "redo" },
    { "op": "assert_component", "entity": "player", "component": "Collider" },
    { "op": "assert_property", "entity": "player", "component": "Rigidbody", "property": "mass", "value": 2.5 },
    { "op": "create_entity", "id": "prefab_parent", "name": "PrefabParent" },
    { "op": "duplicate_entity", "entity": "player", "id": "player_clone" },
    { "op": "rename_entity", "entity": "player_clone", "name": "PlayerClone" },
    { "op": "reparent_entity", "entity": "player_clone", "parent": "prefab_parent" },
    { "op": "assert_parent", "entity": "player_clone", "parent": "prefab_parent" },
    { "op": "create_prefab", "entity": "player_clone", "path": "Assets/Prefabs/AutomationClone.kbprefab" },
    { "op": "assert_asset", "path": "/Game/Prefabs/AutomationClone.kbprefab", "type": "ScenePrefab" },
    { "op": "instantiate_prefab", "id": "prefab_instance", "path": "Assets/Prefabs/AutomationClone.kbprefab", "virtual_path": "/Game/Prefabs/AutomationClone.kbprefab", "name": "PrefabInstance", "x": 3.0, "y": 0.0, "z": 0.0 },
    { "op": "assert_component", "entity": "prefab_instance", "component": "Rigidbody" },
    { "op": "delete_entity", "entity": "prefab_instance" },
    { "op": "assert_entity", "entity": "prefab_instance", "exists": false },
    { "op": "undo" },
    { "op": "assert_entity", "entity": "prefab_instance" },
    { "op": "redo" },
    { "op": "assert_entity", "entity": "prefab_instance", "exists": false },

    {
      "op": "write_file",
      "path": "Assets/Automation/UniversalRuntimeProbe.lua",
      "content": "local moved = false\nfunction Ready(self, dt)\n  Log(\"universal probe ready\")\nend\nfunction Tick(self, dt)\n  local v = Input.Value(\"Move\")\n  if v ~= 0 then\n    Physics.SetVelocity(self.entity, v * 4.0, 0.0, 0.0)\n    if not moved then\n      moved = true\n      Log(\"universal probe input observed\")\n    end\n  end\nend\n"
    },
    {
      "op": "write_file",
      "path": "Source/RuntimeTriangle.obj",
      "content": "v -1.0 -1.0 0.0\nv 1.0 -1.0 0.0\nv 0.0 1.0 0.0\nvt 0 0\nvt 1 0\nvt 0.5 1\nvn 0 0 1\nf 1/1/1 2/2/1 3/3/1\n"
    },
    { "op": "discover_assets" },
    { "op": "write_file", "path": "Assets/AutomationCopies/.keep", "content": "" },
    { "op": "write_file", "path": "Assets/AutomationMoved/.keep", "content": "" },
    { "op": "copy_asset", "asset": "/Game/Automation/UniversalRuntimeProbe.lua", "destination": "/Game/AutomationCopies" },
    { "op": "assert_asset", "path": "/Game/AutomationCopies/UniversalRuntimeProbe.lua", "type": "LuaScript" },
    { "op": "move_asset", "asset": "/Game/AutomationCopies/UniversalRuntimeProbe.lua", "destination": "/Game/AutomationMoved" },
    { "op": "assert_asset", "path": "/Game/AutomationMoved/UniversalRuntimeProbe.lua", "type": "LuaScript" },
    { "op": "delete_asset", "asset": "/Game/AutomationMoved/UniversalRuntimeProbe.lua" },
    { "op": "assert_asset", "path": "/Game/AutomationMoved/UniversalRuntimeProbe.lua", "exists": false },
    { "op": "import_asset", "source": "Source/RuntimeTriangle.obj", "destination": "/Game/Meshes" },
    { "op": "create_mesh_entity", "id": "render_probe", "asset": "/Game/Meshes/RuntimeTriangle.21kb" },
    { "op": "attach_script", "entity": "player", "asset": "/Game/Automation/UniversalRuntimeProbe.lua" },
    { "op": "open_asset", "asset": "/Game/Automation/UniversalRuntimeProbe.lua" },
    { "op": "capture", "panel": "script_editor", "checkpoint": "01-script-editor" },

    { "op": "create_asset", "id": "move_action", "type": "input_action", "folder": "/Game/Input" },
    { "op": "configure_input_action", "asset": "move_action", "name": "Move", "value_type": "Axis1D" },
    { "op": "create_asset", "id": "gameplay_context", "type": "input_context", "folder": "/Game/Input" },
    { "op": "configure_input_mapping", "context": "gameplay_context", "index": 0, "key": "D", "scale": 1.0 },
    { "op": "activate_input_context", "asset": "gameplay_context" },

    { "op": "create_asset", "id": "material_graph", "type": "material_graph", "folder": "/Game/Materials" },
    { "op": "create_asset", "id": "runtime_material", "type": "material", "folder": "/Game/Materials" },
    { "op": "open_asset", "asset": "runtime_material" },
    { "op": "set_material", "asset": "runtime_material", "property": "roughness", "value": 0.35 },
    { "op": "assert_material", "asset": "runtime_material", "property": "roughness", "value": 0.35 },
    { "op": "set_material", "asset": "runtime_material", "property": "double_sided", "value": true },
    { "op": "assert_material", "asset": "runtime_material", "property": "double_sided", "value": true },
    { "op": "save_material", "asset": "runtime_material" },
    { "op": "assign_asset", "entity": "render_probe", "asset": "runtime_material", "role": "material" },
    { "op": "open_asset", "asset": "material_graph" },
    { "op": "find_material_node", "asset": "material_graph", "id": "graph_output", "kind": "MaterialOutput" },
    { "op": "add_material_node", "asset": "material_graph", "id": "graph_color", "kind": "ConstantColor", "x": 120, "y": 160 },
    { "op": "connect_material_nodes", "asset": "material_graph", "from": "graph_color", "from_pin": "rgba", "to": "graph_output", "to_pin": "baseColor" },
    { "op": "save_material", "asset": "material_graph" },
    { "op": "wait_material_cook", "timeout_ms": 60000 },
    { "op": "capture", "panel": "material_editor", "checkpoint": "02-material-editor" },
    { "op": "capture", "panel": "assets", "checkpoint": "03-assets" },
    { "op": "capture", "panel": "project_settings", "checkpoint": "04-project-settings" },
    { "op": "capture", "panel": "plugins", "checkpoint": "05-plugins" },

    { "op": "select_entity", "entity": "player" },
    { "op": "set_project_input_enabled", "enabled": true },
    { "op": "set_plugin", "id": "Physics.Jolt", "enabled": true },
    { "op": "set_plugin", "id": "Audio.Miniaudio", "enabled": true },
    { "op": "set_plugin", "id": "Rendering.BasicLighting", "enabled": true },
    { "op": "assert_plugin", "id": "Physics.Jolt", "enabled": true },
    { "op": "assert_plugin", "id": "Audio.Miniaudio", "enabled": true },
    { "op": "assert_plugin", "id": "Rendering.BasicLighting", "enabled": true },
    { "op": "save_scene", "path": "Assets/Scenes/UniversalScenario.21kbscene" },
    { "op": "reload_scene" },
    { "op": "assert_plugin", "id": "Physics.Jolt", "enabled": true },
    { "op": "assert_plugin", "id": "Audio.Miniaudio", "enabled": true },
    { "op": "assert_plugin", "id": "Rendering.BasicLighting", "enabled": true },
    { "op": "assert_backend", "backend": "physics", "available": true },
    { "op": "assert_backend", "backend": "audio", "available": true },
    { "op": "assert_backend", "backend": "basic_lighting", "available": true },
    { "op": "assert_backend", "backend": "haptics", "available": false },
    { "op": "assert_component", "entity": "player", "component": "Rigidbody" },
    { "op": "capture", "panel": "inspector", "checkpoint": "06-before-play" },
    { "op": "play" },
    { "op": "focus", "focused": true },
    { "op": "pointer", "x": 320.0, "y": 180.0 },
    { "op": "touch", "points": [{ "id": 7, "x": 320.0, "y": 180.0, "phase": "began" }] },
    { "op": "gamepad_connected", "index": 0, "connected": true },
    { "op": "analog", "key": "GamepadLeftStickX", "value": 0.75, "gamepad": 0 },
    { "op": "key", "key": "D", "down": true },
    { "op": "step", "frames": 60, "dt": 0.0166666667 },
    { "op": "key", "key": "D", "down": false },
    { "op": "touch", "points": [{ "id": 7, "x": 321.0, "y": 180.0, "phase": "ended" }] },
    { "op": "step", "frames": 2, "dt": 0.0166666667 },
    { "op": "assert_console", "contains": "universal probe ready", "category": "Script", "level": "info" },
    { "op": "assert_console", "contains": "universal probe input observed", "category": "Script", "level": "info" },
    { "op": "assert_no_errors" },
    { "op": "capture_runtime", "checkpoint": "runtime-gpu", "require_non_uniform": true },
    { "op": "capture", "panel": "inspector", "checkpoint": "07-runtime-result" },
    { "op": "capture", "panel": "console", "checkpoint": "08-runtime-console" },
    { "op": "capture", "panel": "scene", "checkpoint": "09-scene-panel" },
    { "op": "snapshot", "kind": "console", "checkpoint": "runtime" },
    { "op": "snapshot", "kind": "inspector_tree", "checkpoint": "runtime" },
    { "op": "stop" },
    { "op": "assert_property", "entity": "player", "component": "Transform", "property": "localPosition.x", "value": 0.0, "tolerance": 0.0001 },
    { "op": "capture", "panel": "hierarchy", "checkpoint": "10-restored-hierarchy" },
    { "op": "open_scene", "path": "Assets/Scenes/UniversalScenario.21kbscene" },
    { "op": "capture", "panel": "hierarchy", "checkpoint": "11-reloaded-scene" }
  ]
}
