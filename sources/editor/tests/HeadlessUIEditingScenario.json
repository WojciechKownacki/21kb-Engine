{
  "schema": "21kb.editor-automation/v1",
  "steps": [
    { "op": "create_ui_screen", "id": "menu", "screen": "Main Menu" },
    { "op": "bind_entity", "id": "play", "name": "Play" },
    { "op": "assert_component", "entity": "play", "component": "kb21.ui.button" },
    { "op": "assert_property", "entity": "play", "component": "kb21.ui.selectable", "property": "eventName", "value": "PlayClicked" },
    { "op": "assert_parent", "entity": "play", "parent": "menu" },
    { "op": "undo" },
    { "op": "bind_entity", "id": "gone", "name": "Play", "exists": false },
    { "op": "redo" },
    { "op": "create_ui_screen", "id": "hud", "screen": "HUD" },
    { "op": "bind_entity", "id": "score", "name": "Score" },
    { "op": "assert_component", "entity": "score", "component": "kb21.ui.text" },
    { "op": "create_ui_screen", "id": "pause", "screen": "Pause" },
    { "op": "bind_entity", "id": "resume", "name": "Resume" },
    { "op": "assert_property", "entity": "resume", "component": "kb21.ui.selectable", "property": "eventName", "value": "ResumeClicked" },
    { "op": "create_ui_screen", "id": "settings", "screen": "Settings" },
    { "op": "bind_entity", "id": "back", "name": "Back" },
    { "op": "assert_property", "entity": "back", "component": "kb21.ui.selectable", "property": "eventName", "value": "BackClicked" },
    { "op": "capture", "panel": "hierarchy", "checkpoint": "ui-screens-hierarchy", "text_fits": true },
    { "op": "new_scene" },
    { "op": "create_entity", "id": "box", "name": "Box" },
    { "op": "create_entity", "id": "lid", "name": "Lid" },
    { "op": "reparent_entity", "entity": "lid", "parent": "box" },
    { "op": "copy_entity", "entity": "box" },
    { "op": "paste_entity", "id": "box_copy" },
    { "op": "rename_entity", "entity": "box_copy", "name": "BoxCopy" },
    { "op": "assert_entity", "entity": "box_copy", "exists": true },
    { "op": "cut_entity", "entity": "box" },
    { "op": "assert_entity", "entity": "box", "exists": false },
    { "op": "paste_entity", "id": "box_moved" },
    { "op": "assert_entity", "entity": "box_moved", "exists": true },
    { "op": "write_file", "path": "Assets/Scripts/ClickAudit.lua", "content": "function QuitClicked(self, event)\n    Log(\"quit clicked\")\nend\n\nfunction Tick(self, dt)\nend\n" },
    { "op": "discover_assets" },
    { "op": "assert_ui_click_handler" },
    { "op": "assert_no_errors" }
  ]
}
