{
  "schema": "21kb.editor-automation/v1",
  "steps": [
    { "op": "create_scene", "name": "AgentGuidance", "template": "Empty" },
    { "op": "save_scene" },

    { "op": "agent_scripted", "model": "light" },
    { "op": "agent_type", "text": "Add a wooden crate near the old door in the scene" },
    { "op": "agent_expect", "hint": "none" },
    { "op": "agent_send" },
    { "op": "agent_wait", "until": "idle" },
    { "op": "agent_expect", "entries": ["Done."], "uncached": 1000, "cache_read": 3000, "cache_write": 500, "output": 200, "priced_cost": 0.002925, "program_cost": 0.02, "cost_complete": true },

    { "op": "agent_scripted", "model": "strong" },
    { "op": "agent_type", "text": "Make the crate red" },
    { "op": "agent_expect", "hint": "use_model", "hint_model": "light", "card": "advice", "buttons": 2, "button": "Stay with Strong" },
    { "op": "capture", "panel": "agent", "checkpoint": "agent-hint" },
    { "op": "agent_bar", "checkpoint": "agent-bar-hint", "press": 1 },
    { "op": "agent_expect", "model": "strong", "hint": "none", "card": "none", "settle_seconds": 1, "running": false },
    { "op": "agent_scripted", "model": "middle" },
    { "op": "agent_type", "text": "Make the crate blue" },
    { "op": "agent_expect", "hint": "use_model", "hint_model": "light" },
    { "op": "agent_bar", "checkpoint": "agent-bar-hint-2", "press": 0 },
    { "op": "agent_expect", "model": "light", "hint": "none" },

    { "op": "agent_scripted", "model": "gone" },
    { "op": "agent_expect", "card": "stuck", "buttons": 4, "button": "The program's own", "model": "gone", "settle_seconds": 1, "running": false },
    { "op": "agent_press", "target": "card", "index": 2 },
    { "op": "agent_expect", "model": "light", "card": "none" },

    { "op": "agent_type", "text": "Compose a gentle piano melody for the credits screen" },
    { "op": "agent_expect", "hint": "fresh", "conversations": 1 },
    { "op": "agent_press", "target": "card" },
    { "op": "agent_expect", "conversations": 2, "draft": "Compose a gentle piano melody for the credits screen", "hint": "none" },

    { "op": "agent_type", "text": "LOOPCASE make it work" },
    { "op": "agent_send" },
    { "op": "agent_wait", "until": "card", "timeout_seconds": 90 },
    { "op": "agent_expect", "card": "stuck", "buttons": 4, "button": "Continue with Middle", "plan_phase": "none" },
    { "op": "capture", "panel": "agent", "checkpoint": "agent-stuck" },
    { "op": "agent_bar", "checkpoint": "agent-bar-stuck" },
    { "op": "set_language", "language": "pl" },
    { "op": "capture", "panel": "agent", "checkpoint": "agent-stuck-pl", "text_fits": true },
    { "op": "set_language", "language": "en" },
    { "op": "agent_key", "key": "tab" },
    { "op": "agent_expect", "focus": 0 },
    { "op": "agent_key", "key": "tab" },
    { "op": "agent_expect", "focus": 1 },
    { "op": "agent_key", "key": "escape" },
    { "op": "agent_expect", "focus": -1 },
    { "op": "agent_key", "key": "tab" },
    { "op": "agent_key", "key": "enter" },
    { "op": "agent_wait", "until": "idle" },
    { "op": "agent_expect", "card": "none", "model": "middle", "entries": ["Fixed it."] },

    { "op": "agent_scripted", "model": "light" },
    { "op": "agent_type", "text": "LOOPCASE again" },
    { "op": "agent_send" },
    { "op": "agent_wait", "until": "card", "timeout_seconds": 90 },
    { "op": "agent_press", "target": "card", "index": 1 },
    { "op": "agent_wait", "until": "plan_review", "timeout_seconds": 90 },
    { "op": "agent_expect", "plan_phase": "review", "plan_steps": 3, "card": "plan", "buttons": 2 },
    { "op": "capture", "panel": "agent", "checkpoint": "agent-plan" },
    { "op": "agent_bar", "checkpoint": "agent-bar-plan", "press": 2 },
    { "op": "agent_press", "target": "plan_toggle", "index": 0 },
    { "op": "agent_expect", "plan_off": 1 },
    { "op": "agent_press", "target": "plan_toggle", "index": 0 },
    { "op": "agent_press", "target": "plan_down", "index": 0 },
    { "op": "agent_expect", "plan_first": "Add a crate on the floor" },
    { "op": "agent_press", "target": "plan_up", "index": 1 },
    { "op": "agent_expect", "plan_first": "Add a floor", "plan_off": 0 },
    { "op": "agent_press", "target": "plan_edit", "index": 0 },
    { "op": "agent_expect", "draft": "Add a floor" },
    { "op": "agent_type", "text": "Add a wide floor" },
    { "op": "agent_send" },
    { "op": "agent_expect", "plan_first": "Add a wide floor", "draft": "" },
    { "op": "agent_press", "target": "card", "index": 0 },
    { "op": "agent_wait", "until": "card", "timeout_seconds": 240 },
    { "op": "agent_expect", "card": "stuck", "buttons": 4, "button": "Continue with Middle", "plan_phase": "running", "settle_seconds": 3, "running": false, "model": "light" },
    { "op": "capture", "panel": "agent", "checkpoint": "agent-plan-stuck" },
    { "op": "agent_press", "target": "card", "index": 0 },
    { "op": "agent_wait", "until": "plan_end", "timeout_seconds": 240 },
    { "op": "agent_expect", "plan_phase": "none", "card": "none", "model": "light", "entries": ["Step 1 of 3", "Step 3 of 3", "Step 2 is done.", "Step 3 is done.", "All the steps are done."] },

    { "op": "agent_scripted", "model": "light" },
    { "op": "agent_type", "text": "LOOPCASE third" },
    { "op": "agent_send" },
    { "op": "agent_wait", "until": "card", "timeout_seconds": 90 },
    { "op": "agent_bar", "checkpoint": "agent-bar-stuck-stop", "press": 3 },
    { "op": "agent_expect", "card": "none", "entries": ["Stopped."] },

    { "op": "agent_type", "text": "LOOPCASE fourth" },
    { "op": "agent_send" },
    { "op": "agent_wait", "until": "card", "timeout_seconds": 90 },
    { "op": "agent_press", "target": "card", "index": 2 },
    { "op": "agent_wait", "until": "idle" },
    { "op": "agent_expect", "card": "none", "model": "light" },

    { "op": "agent_type", "text": "PLANCASE build the whole game with menu, enemies and levels" },
    { "op": "agent_expect", "hint": "fresh", "conversations": 2 },
    { "op": "agent_press", "target": "card" },
    { "op": "agent_expect", "conversations": 3, "hint": "plan", "draft": "PLANCASE build the whole game with menu, enemies and levels" },
    { "op": "agent_press", "target": "card" },
    { "op": "agent_wait", "until": "plan_review", "timeout_seconds": 90 },
    { "op": "agent_expect", "plan_phase": "review", "plan_steps": 3, "draft": "" },
    { "op": "agent_press", "target": "card", "index": 1 },
    { "op": "agent_expect", "plan_phase": "none", "card": "none" },
    { "op": "agent_scripted", "model": "middle" },
    { "op": "agent_type", "text": "LOOPCASE fifth" },
    { "op": "agent_send" },
    { "op": "agent_wait", "until": "card", "timeout_seconds": 90 },
    { "op": "agent_press", "target": "card", "index": 1 },
    { "op": "agent_wait", "until": "plan_review", "timeout_seconds": 90 },
    { "op": "agent_press", "target": "card", "index": 0 },
    { "op": "agent_wait", "until": "plan_end", "timeout_seconds": 240 },
    { "op": "agent_expect", "plan_phase": "none", "card": "none", "model": "middle", "entries": ["Step 3 is done.", "All the steps are done."] },
    { "op": "assert_no_errors" }
  ]
}
