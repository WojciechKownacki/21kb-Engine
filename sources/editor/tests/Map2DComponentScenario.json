{
  "schema": "21kb.editor-automation/v1",
  "steps": [
    {"op": "configure_runtime_rendering", "width": 960, "height": 540},
    {"op": "create_scene", "name": "MapComponents", "template": "Empty"},
    {"op": "set_language", "language": "pl"},
    {"op": "copy_fixture", "source": "fixtures/map2d/Tiles.png", "destination": "Assets/2D Map Sprites/Nature/Tiles.png"},
    {"op": "discover_assets"},
    {"op": "create_entity", "id": "plane", "name": "Plane", "preset": "Plane"},
    {"op": "add_component", "entity": "plane", "component": "Collider"},
    {"op": "set_property", "entity": "plane", "component": "Collider", "property": "friction", "value": 0.73},
    {"op": "remember_mesh_renderer", "entity": "plane"},
    {"op": "add_component", "entity": "plane", "component": "World2DMap"},
    {"op": "assert_component", "entity": "plane", "component": "World2DMap"},
    {"op": "assert_mesh_renderer_unchanged", "entity": "plane"},
    {"op": "assert_property", "entity": "plane", "component": "Collider", "property": "friction", "value": 0.73},
    {"op": "undo"},
    {"op": "assert_component", "entity": "plane", "component": "World2DMap", "exists": false},
    {"op": "assert_mesh_renderer_unchanged", "entity": "plane"},
    {"op": "redo"},
    {"op": "assert_component", "entity": "plane", "component": "World2DMap"},
    {"op": "assert_mesh_renderer_unchanged", "entity": "plane"},
    {"op": "map2d_layer_toggle", "entity": "plane", "field": "visible"},
    {"op": "map2d_layer_toggle", "entity": "plane", "field": "visible"},
    {"op": "set_inspector_scroll", "position": "top"},
    {"op": "capture", "panel": "inspector", "checkpoint": "plane-and-tilemap", "width": 480, "height": 1200},
    {"op": "map2d_editor", "entity": "plane", "checkpoint": "plane-map-painted", "width": 1100, "height": 700, "inputs": ["click 25 185", "drag 560 280 720 280", "key s ctrl"]},
    {"op": "assert_mesh_renderer_unchanged", "entity": "plane"},
    {"op": "save_scene"},
    {"op": "set_startup_scene", "path": "/Game/Scenes/MapComponents.21kbscene"},
    {"op": "open_scene", "path": "Assets/Scenes/MapComponents.21kbscene"},
    {"op": "assert_component", "entity": "plane", "component": "World2DMap"},
    {"op": "assert_mesh_renderer_unchanged", "entity": "plane"},
    {"op": "assert_property", "entity": "plane", "component": "Collider", "property": "friction", "value": 0.73},
    {"op": "play"},
    {"op": "step", "frames": 3},
    {"op": "assert_map2d_runtime", "entity": "plane"},
    {"op": "assert_mesh_renderer_unchanged", "entity": "plane"},
    {"op": "stop"},
    {"op": "assert_mesh_renderer_unchanged", "entity": "plane"},
    {"op": "duplicate_entity", "entity": "plane", "id": "shared", "name": "SharedMap"},
    {"op": "assert_map2d_sharing", "entity": "plane", "other": "shared", "shared": true, "same_content": true},
    {"op": "map2d_editor", "entity": "plane", "checkpoint": "plane-map-unique", "inputs": ["unique"]},
    {"op": "assert_map2d_sharing", "entity": "plane", "other": "shared", "shared": false, "same_content": true},
    {"op": "undo"},
    {"op": "assert_map2d_sharing", "entity": "plane", "other": "shared", "shared": true, "same_content": true},
    {"op": "redo"},
    {"op": "assert_map2d_sharing", "entity": "plane", "other": "shared", "shared": false, "same_content": true},
    {"op": "map2d_editor", "entity": "plane", "checkpoint": "plane-map-independent", "inputs": ["parallax 2 1", "key s ctrl"]},
    {"op": "assert_map2d_sharing", "entity": "plane", "other": "shared", "shared": false, "same_content": false},
    {"op": "save_scene"},
    {"op": "open_scene", "path": "Assets/Scenes/MapComponents.21kbscene"},
    {"op": "assert_map2d_sharing", "entity": "plane", "other": "shared", "shared": false, "same_content": false},
    {"op": "assert_mesh_renderer_unchanged", "entity": "plane"},
    {"op": "remove_component", "entity": "plane", "component": "World2DMap"},
    {"op": "assert_mesh_renderer_unchanged", "entity": "plane"},
    {"op": "assert_property", "entity": "plane", "component": "Collider", "property": "friction", "value": 0.73},
    {"op": "undo"},
    {"op": "assert_component", "entity": "plane", "component": "World2DMap"},
    {"op": "assert_mesh_renderer_unchanged", "entity": "plane"},
    {"op": "redo"},
    {"op": "assert_component", "entity": "plane", "component": "World2DMap", "exists": false},
    {"op": "assert_mesh_renderer_unchanged", "entity": "plane"},
    {"op": "undo"},
    {"op": "remove_component", "entity": "plane", "component": "MeshRenderer"},
    {"op": "assert_component", "entity": "plane", "component": "World2DMap"},
    {"op": "map2d_layer_toggle", "entity": "plane", "field": "locked"},
    {"op": "map2d_layer_toggle", "entity": "plane", "field": "locked"},
    {"op": "set_inspector_scroll", "position": "top"},
    {"op": "capture", "panel": "inspector", "checkpoint": "tilemap-without-mesh", "width": 480, "height": 1000},
    {"op": "assert_no_errors"}
  ]
}
