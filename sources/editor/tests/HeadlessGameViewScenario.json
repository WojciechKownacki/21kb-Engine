{
  "schema": "21kb.editor-automation/v1",
  "steps": [
    { "op": "new_scene" },
    { "op": "create_entity", "id": "camera", "name": "GameCamera" },
    { "op": "set_entity_position", "entity": "camera", "x": 0, "y": 0, "z": -5 },
    { "op": "add_component", "entity": "camera", "component": "Camera" },
    { "op": "set_property", "entity": "camera", "component": "Camera", "property": "primary", "value": true },
    { "op": "set_property", "entity": "camera", "component": "Camera", "property": "clearColor.x", "value": 0.0 },
    { "op": "set_property", "entity": "camera", "component": "Camera", "property": "clearColor.y", "value": 0.0 },
    { "op": "set_property", "entity": "camera", "component": "Camera", "property": "clearColor.z", "value": 1.0 },
    { "op": "save_scene", "path": "Assets/Scenes/GameView.21kbscene" },
    { "op": "capture", "panel": "game", "checkpoint": "game-panel-stopped", "width": 900, "height": 700, "text_fits": true },

    { "op": "set_play_target", "target": "game_view" },
    { "op": "set_game_view_device", "device": "Computer", "portrait": false, "safe_area": false },
    { "op": "play" },
    { "op": "assert_game_view_settings", "area_width": 640, "area_height": 360 },
    { "op": "capture", "panel": "game", "checkpoint": "game-panel-playing", "width": 900, "height": 700, "text_fits": true },

    { "op": "assert_game_view_layout", "area_width": 640, "area_height": 360, "render_width": 1920, "render_height": 1080, "left": 19, "top": 11, "right": 620, "bottom": 349, "scale": "31%" },
    { "op": "capture_game_view", "checkpoint": "game-computer", "area_width": 640, "area_height": 360 },
    { "op": "assert_capture_size", "checkpoint": "game-computer", "width": 1920, "height": 1080 },
    { "op": "assert_capture_color", "checkpoint": "game-computer", "color": [0, 0, 255], "tolerance": 60, "min_pixels": 2050000 },

    { "op": "set_game_view_device", "device": "Tablet" },
    { "op": "assert_game_view_layout", "area_width": 640, "area_height": 360, "render_width": 1544, "render_height": 907, "left": 68, "top": 32, "right": 571, "bottom": 328, "scale": "33%" },
    { "op": "capture_game_view", "checkpoint": "game-tablet", "area_width": 640, "area_height": 360 },
    { "op": "assert_capture_size", "checkpoint": "game-tablet", "width": 1544, "height": 907 },
    { "op": "assert_capture_color", "checkpoint": "game-tablet", "color": [0, 0, 255], "tolerance": 60, "min_pixels": 1350000 },
    { "op": "capture", "panel": "game", "checkpoint": "game-panel-tablet", "width": 900, "height": 700, "text_fits": true },

    { "op": "set_game_view_device", "device": "Tablet", "portrait": true },
    { "op": "assert_game_view_layout", "area_width": 640, "area_height": 360, "render_width": 907, "render_height": 1544, "left": 229, "top": 25, "right": 411, "bottom": 335, "scale": "20%" },
    { "op": "capture_game_view", "checkpoint": "game-tablet-portrait", "area_width": 640, "area_height": 360 },
    { "op": "assert_capture_size", "checkpoint": "game-tablet-portrait", "width": 907, "height": 1544 },

    { "op": "set_game_view_device", "device": "Phone", "portrait": false, "safe_area": true },
    { "op": "assert_game_view_layout", "area_width": 640, "area_height": 360, "render_width": 2340, "render_height": 1080, "left": 26, "top": 44, "right": 613, "bottom": 315, "scale": "25%" },
    { "op": "assert_game_view_settings", "area_width": 640, "area_height": 360 },
    { "op": "capture_game_view", "checkpoint": "game-phone", "area_width": 640, "area_height": 360 },
    { "op": "assert_capture_size", "checkpoint": "game-phone", "width": 2340, "height": 1080 },
    { "op": "assert_capture_color", "checkpoint": "game-phone", "color": [0, 0, 255], "tolerance": 60, "min_pixels": 2450000 },
    { "op": "capture", "panel": "game", "checkpoint": "game-panel-phone", "width": 900, "height": 700, "text_fits": true },

    { "op": "set_game_view_device", "device": "Phone", "portrait": true },
    { "op": "assert_game_view_layout", "area_width": 640, "area_height": 360, "render_width": 1080, "render_height": 2340, "left": 246, "top": 20, "right": 393, "bottom": 339, "scale": "14%" },
    { "op": "assert_game_view_settings", "area_width": 640, "area_height": 360 },
    { "op": "capture", "panel": "game", "checkpoint": "game-panel-phone-portrait", "width": 900, "height": 700, "text_fits": true },

    { "op": "set_game_view_device", "device": "Computer", "portrait": true },
    { "op": "assert_game_view_layout", "area_width": 640, "area_height": 360, "render_width": 1920, "render_height": 1080, "left": 19, "top": 11, "right": 620, "bottom": 349, "scale": "31%" },
    { "op": "assert_game_view_settings", "area_width": 640, "area_height": 360 },
    { "op": "capture", "panel": "game", "checkpoint": "game-panel-computer-safe", "width": 900, "height": 700, "text_fits": true },
    { "op": "assert_game_view_layout", "area_width": 400, "area_height": 300, "render_width": 1920, "render_height": 1080, "left": 11, "top": 43, "right": 389, "bottom": 256, "scale": "20%" },

    { "op": "set_game_view_device", "device": "Tablet", "portrait": false, "safe_area": true },
    { "op": "console_message", "level": "warning", "text": "The lighting of this scene was built for an older version of its objects and needs to be built again before the baked light shows the objects where they are now. Choose World, Build Lighting." },
    { "op": "console_message", "level": "error", "text": "Script Player failed: attempt to index a nil value" },
    { "op": "assert_game_view_settings", "area_width": 640, "area_height": 360 },
    { "op": "capture_game_view", "checkpoint": "game-tablet-messages", "area_width": 640, "area_height": 360 },
    { "op": "capture_game_view_overlay", "checkpoint": "game-tablet-overlay", "picture": "game-tablet-messages", "area_width": 640, "area_height": 360 },
    { "op": "clear_console" },
    { "op": "set_game_view_device", "device": "Computer", "portrait": false, "safe_area": false },
    { "op": "stop" },

    { "op": "set_play_target", "target": "scene_view" },
    { "op": "play" },
    { "op": "assert_game_view_settings", "area_width": 640, "area_height": 360 },
    { "op": "stop" },
    { "op": "set_play_target", "target": "game_view" },
    { "op": "assert_no_errors" }
  ]
}
