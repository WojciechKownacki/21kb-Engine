{
  "schema": "21kb.editor-automation/v1",
  "steps": [
    { "op": "new_scene" },
    { "op": "create_entity", "id": "sky", "name": "Sky" },
    { "op": "add_component", "entity": "sky", "component": "WorldBackdrop" },
    { "op": "set_property", "entity": "sky", "component": "WorldBackdrop", "property": "mode", "value": 0 },
    { "op": "set_property", "entity": "sky", "component": "WorldBackdrop", "property": "color.x", "value": 0.7 },
    { "op": "set_property", "entity": "sky", "component": "WorldBackdrop", "property": "color.y", "value": 0.7 },
    { "op": "set_property", "entity": "sky", "component": "WorldBackdrop", "property": "color.z", "value": 0.7 },

    { "op": "create_asset", "id": "look", "type": "post_process_profile", "folder": "/Game" },
    { "op": "assert_file", "path": "Assets/PostProcessProfile.kbppfx", "contains": "vignetteEnabled 0" },
    { "op": "assert_post_process_profile", "asset": "look", "field": "vignetteEnabled", "value": "0" },
    { "op": "post_process_row", "asset": "look", "field": "vignetteEnabled" },
    { "op": "assert_post_process_profile", "asset": "look", "field": "vignetteEnabled", "value": "1" },
    { "op": "post_process_row", "asset": "look", "field": "vignetteIntensity", "text": "1" },
    { "op": "assert_post_process_profile", "asset": "look", "field": "vignetteIntensity", "value": "1" },
    { "op": "post_process_row", "asset": "look", "field": "vignetteIntensity", "text": "7" },
    { "op": "assert_post_process_profile", "asset": "look", "field": "vignetteIntensity", "value": "1" },
    { "op": "post_process_row", "asset": "look", "field": "outputTransform.tonemap" },
    { "op": "assert_post_process_profile", "asset": "look", "field": "outputTransform.tonemap", "value": "AgxApprox" },
    { "op": "post_process_row", "asset": "look", "field": "outputTransform.exposureStops", "text": "0.5" },
    { "op": "assert_post_process_profile", "asset": "look", "field": "outputTransform.exposureStops", "value": "0.5" },
    { "op": "post_process_row", "asset": "look", "field": "antiAliasing" },
    { "op": "assert_post_process_profile", "asset": "look", "field": "fxaaEnabled", "value": "1" },
    { "op": "assert_post_process_profile", "asset": "look", "field": "temporalAntiAliasingEnabled", "value": "0" },
    { "op": "undo" },
    { "op": "assert_post_process_profile", "asset": "look", "field": "temporalAntiAliasingEnabled", "value": "1" },
    { "op": "redo" },
    { "op": "assert_post_process_profile", "asset": "look", "field": "temporalAntiAliasingEnabled", "value": "0" },
    { "op": "post_process_row", "asset": "look", "field": "ambientOcclusionEnabled" },
    { "op": "assert_post_process_profile", "asset": "look", "field": "ambientOcclusionEnabled", "value": "1" },
    { "op": "post_process_row", "asset": "look", "field": "ambientOcclusionRadius", "text": "0.8" },
    { "op": "assert_post_process_profile", "asset": "look", "field": "ambientOcclusionRadius", "value": "0.8" },
    { "op": "assert_file", "path": "Assets/PostProcessProfile.kbppfx", "contains": "vignetteIntensity 1" },

    { "op": "select_entity", "entity": "sky" },
    { "op": "assert_scene_post_process_profile", "asset": "none" },
    { "op": "assert_viewport_post_process", "field": "vignetteEnabled", "value": "0" },
    { "op": "set_scene_post_process_profile", "asset": "look" },
    { "op": "assert_scene_post_process_profile", "asset": "look" },
    { "op": "assert_viewport_post_process", "field": "vignetteEnabled", "value": "1" },
    { "op": "assert_viewport_post_process", "field": "vignetteIntensity", "value": "1" },
    { "op": "assert_viewport_post_process", "field": "ambientOcclusionEnabled", "value": "1" },
    { "op": "assert_viewport_post_process", "field": "outputTransform.exposureStops", "value": "0.5" },
    { "op": "assert_viewport_post_process", "field": "temporalAntiAliasingEnabled", "value": "0" },
    { "op": "post_process_row", "asset": "look", "field": "vignetteIntensity", "text": "0.4" },
    { "op": "assert_viewport_post_process", "field": "vignetteIntensity", "value": "0.4" },
    { "op": "undo" },
    { "op": "assert_viewport_post_process", "field": "vignetteIntensity", "value": "1" },
    { "op": "undo" },
    { "op": "assert_scene_post_process_profile", "asset": "none" },
    { "op": "assert_viewport_post_process", "field": "vignetteEnabled", "value": "0" },
    { "op": "redo" },
    { "op": "assert_scene_post_process_profile", "asset": "look" },
    { "op": "clear_scene_post_process_profile" },
    { "op": "assert_scene_post_process_profile", "asset": "none" },
    { "op": "undo" },
    { "op": "assert_scene_post_process_profile", "asset": "look" },
    { "op": "save_scene", "path": "Assets/Scenes/Look.21kbscene" },
    { "op": "open_scene", "path": "Assets/Scenes/Look.21kbscene" },
    { "op": "assert_scene_post_process_profile", "asset": "look" },

    { "op": "create_asset", "id": "preset", "type": "import_preset", "folder": "/Game" },
    { "op": "assert_file", "path": "Assets/ImportPreset.kbimportpreset", "contains": "importMaterials 1" },
    { "op": "write_file", "path": "Assets/ImportPreset.kbimportpreset", "content": "scale 2\nrotation 0,90,0\nimportMaterials 0\nimportTextures 0\n" },
    { "op": "write_file", "path": "Source/PresetTriangle.obj", "content": "v -1 -1 0\nv 1 -1 0\nv 0 1 0\nf 1 2 3\n" },
    { "op": "import_asset", "source": "Source/PresetTriangle.obj", "destination": "/Game/Models", "preset": "preset" },
    { "op": "assert_import_transform", "path": "/Game/Models/PresetTriangle.21kb", "scale": 2, "rotation": [0, 90, 0] },
    { "op": "write_file", "path": "Source/ScaledTriangle.obj", "content": "v -1 -1 0\nv 1 -1 0\nv 0 1 0\nf 1 2 3\n" },
    { "op": "import_asset", "source": "Source/ScaledTriangle.obj", "destination": "/Game/Models", "preset": "preset", "scale": 0.5, "rotation": [-90, 0, 0] },
    { "op": "assert_import_transform", "path": "/Game/Models/ScaledTriangle.21kb", "scale": 0.5, "rotation": [-90, 0, 0] },
    { "op": "import_asset", "source": "Source/ScaledTriangle.obj", "destination": "/Game/Models", "scale": 0, "refused": true },
    { "op": "assert_console", "contains": "scale must be above zero" },
    { "op": "clear_console" },
    { "op": "assert_import_transform", "path": "/Game/Models/ScaledTriangle.21kb", "scale": 0.5, "rotation": [-90, 0, 0] },
    { "op": "write_file", "path": "Source/PlainTriangle.obj", "content": "v -1 -1 0\nv 1 -1 0\nv 0 1 0\nf 1 2 3\n" },
    { "op": "import_asset", "source": "Source/PlainTriangle.obj", "destination": "/Game/Models" },
    { "op": "assert_import_transform", "path": "/Game/Models/PlainTriangle.21kb", "scale": 1, "rotation": [0, 0, 0] },
    { "op": "assert_no_errors" }
  ]
}
