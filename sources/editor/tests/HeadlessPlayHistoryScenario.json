{
  "schema": "21kb.editor-automation/v1",
  "steps": [
    { "op": "create_scene", "name": "PlayHistory", "template": "Empty" },
    { "op": "create_entity", "id": "parent", "name": "Parent" },
    { "op": "create_entity", "id": "target", "name": "HistoryTarget" },
    { "op": "reparent_entity", "entity": "target", "parent": "parent" },
    { "op": "select_entity", "entity": "target" },
    { "op": "add_component", "entity": "target", "component": "Light" },
    { "op": "save_scene" },
    { "op": "assert_current_scene", "path": "Assets/Scenes/PlayHistory.21kbscene", "dirty": false },
    { "op": "play" },
    { "op": "add_component", "entity": "target", "component": "Camera" },
    { "op": "set_property", "entity": "target", "component": "Light", "property": "intensity", "value": 9.0 },
    { "op": "assert_property", "entity": "target", "component": "Light", "property": "intensity", "value": 9.0 },
    { "op": "stop" },
    { "op": "assert_current_scene", "path": "Assets/Scenes/PlayHistory.21kbscene", "dirty": false },
    { "op": "assert_component", "entity": "target", "component": "Camera", "exists": false },
    { "op": "assert_property", "entity": "target", "component": "Light", "property": "intensity", "value": 1.0 },
    { "op": "assert_selected_entity", "entity": "target" },
    { "op": "undo", "restore_entity": "target" },
    { "op": "assert_current_scene", "path": "Assets/Scenes/PlayHistory.21kbscene", "dirty": true },
    { "op": "assert_component", "entity": "target", "component": "Light", "exists": false },
    { "op": "play" },
    { "op": "stop" },
    { "op": "assert_current_scene", "path": "Assets/Scenes/PlayHistory.21kbscene", "dirty": true },
    { "op": "redo", "restore_entity": "target" },
    { "op": "assert_component", "entity": "target", "component": "Light" },
    { "op": "assert_property", "entity": "target", "component": "Light", "property": "intensity", "value": 1.0 },
    { "op": "assert_selected_entity", "entity": "target" },
    { "op": "create_asset", "id": "history_material", "type": "material_graph", "folder": "/Game/Materials" },
    { "op": "open_asset", "asset": "history_material" },
    { "op": "find_material_node", "asset": "history_material", "id": "output", "kind": "MaterialOutput" },
    { "op": "add_material_node", "asset": "history_material", "id": "color", "kind": "ConstantColor", "x": 120, "y": 160 },
    { "op": "focus_material_node", "node": "output" },
    { "op": "undo" },
    { "op": "assert_material_node_count", "asset": "history_material", "kind": "ConstantColor", "count": 0 },
    { "op": "play" },
    { "op": "stop" },
    { "op": "focus_material_node", "node": "output" },
    { "op": "redo" },
    { "op": "assert_material_node_count", "asset": "history_material", "kind": "ConstantColor", "count": 1 },
    { "op": "play" },
    { "op": "stop" },
    { "op": "focus_material_node", "node": "output" },
    { "op": "undo" },
    { "op": "assert_material_node_count", "asset": "history_material", "kind": "ConstantColor", "count": 0 },
    { "op": "verify_prefab_round_trip" },
    { "op": "assert_no_errors" }
  ]
}
