text "startup.shaders" "शेडर {done} / {total}"
text "projectSettings.category.audio" "ऑडियो"
text "projectSettings.category.tags" "टैग"
text "projectSettings.masterVolume" "मुख्य वॉल्यूम"
text "projectSettings.masterVolumeDescription" "पूरे गेम की आवाज़; 1 पूरी आवाज़ है।"
text "projectSettings.tagsDescription" "सभी दृश्यों में साझा ऑब्जेक्ट टैग, बिल्ट-इन टैग के अलावा।"
text "projectSettings.audioSection" "ऑडियो"
text "projectSettings.tagsSection" "टैग"
text "projectSettings.tagNameHint" "नए टैग का नाम"
text "projectSettings.tagAdd" "टैग जोड़ें"
text "menu.world.buildLighting" "लाइटिंग बनाएं"
text "projectSettings.renderScale" "रेंडर स्केल"
text "projectSettings.renderScaleDescription" "स्क्रीन रिज़ॉल्यूशन का वह हिस्सा जिस पर 3D दृश्य रेंडर होता है (0.5 से 1); इंटरफ़ेस स्पष्ट रहता है।"
text "curveEditor.tangent.auto" "स्वचालित"
text "curveEditor.tangent.flat" "सपाट"
text "curveEditor.tangent.linear" "रैखिक"
text "curveEditor.tangent.constant" "स्थिर"
text "curveEditor.tangent.free" "मुक्त"
text "projectSettings.microphone" "माइक्रोफ़ोन"
text "projectSettings.microphoneDescription" "गेम को माइक्रोफ़ोन से रिकॉर्ड करने देता है; तब Android पैकेज ऑडियो रिकॉर्ड करने की अनुमति माँगता है।"
text "newProject.template.basic3d" "बेसिक 3D"
text "newProject.template.basic2d" "बेसिक 2D"
text "newProject.template.firstPerson" "फ़र्स्ट पर्सन"
text "newProject.template.thirdPerson" "थर्ड पर्सन"
text "newProject.template.basic2dDescription" "ऑर्थोग्राफ़िक कैमरा और कोलाइडर वाला स्प्राइट फ़र्श, 2D फ़िज़िक्स पर।"
text "newProject.template.firstPersonDescription" "अपनी आँखों से दिखता चलता हुआ किरदार, माउस से देखने की सुविधा के साथ।"
text "newProject.template.thirdPersonDescription" "चलता हुआ किरदार, जिसके पीछे-पीछे कैमरा चलता है।"
text "projectSettings.splashScale" "लॉन्च स्क्रीन का स्केल"
text "projectSettings.splashScaleFit" "फ़िट"
text "projectSettings.splashScaleFill" "भरें"
text "projectSettings.splashScaleCenter" "केंद्र में"
text "projectSettings.splashBackground" "लॉन्च स्क्रीन की पृष्ठभूमि"
text "projectSettings.splashMinimumTime" "लॉन्च स्क्रीन का न्यूनतम समय (ms)"
text "projectSettings.splashProgress" "लॉन्च स्क्रीन प्रगति पट्टी"
text "projectSettings.splashImage" "लॉन्च स्क्रीन छवि"
text "projectSettings.splashImageDescription" "दृश्य लोड होते समय गेम जो चित्र दिखाता है; कोई न हो तो इंजन का चिह्न दिखता है।"
text "projectSettings.splashScaleDescription" "चित्र स्क्रीन में कैसे बैठता है: पूरा, स्क्रीन भरते हुए या अपने आकार में।"
text "projectSettings.splashBackgroundDescription" "चित्र के चारों ओर का रंग, Android पर इंजन शुरू होने से पहले भी।"
text "projectSettings.splashMinimumTimeDescription" "लॉन्च स्क्रीन के दिखने का न्यूनतम समय, भले ही दृश्य जल्दी लोड हो जाए।"
text "projectSettings.splashProgressDescription" "चित्र के नीचे एक पट्टी दिखाता है जो लोडिंग के साथ बढ़ती है।"
text "panel.game" "गेम व्यू"
text "gameView.scale" "स्केल"
text "gameView.pressPlay" "गेम यहाँ देखने के लिए Play दबाएँ।"
text "gameView.noCamera" "कोई कैमरा चित्र नहीं बना रहा है। सीन के किसी कैमरे को प्राथमिक कैमरा चुनें।"
text "gameView.resolution.free" "मुक्त आस्पेक्ट रेशियो"
text "gameView.resolution.project" "प्रोजेक्ट रेज़ोल्यूशन"
text "gameView.resolution.landscape16x9" "16:9 लैंडस्केप"
text "gameView.resolution.portrait9x16" "9:16 फ़ोन पोर्ट्रेट"
text "gameView.resolution.phoneLandscape" "19.5:9 फ़ोन लैंडस्केप"
text "gameView.resolution.tablet4x3" "4:3 टैबलेट"
text "gameView.resolution.tablet16x10" "16:10 टैबलेट"
text "menu.play.gameView" "गेम व्यू में"
text "menu.detail.playGameView" "खिलाड़ी जो देखता है, आपके चुने रेज़ोल्यूशन पर"
text "inspector.affectsNavigation" "नेविगेशन पर असर"
text "inspector.tip.affectsNavigation" "किरदार इस वस्तु पर चलते हैं या इसके चारों ओर घूमते हैं। घास या छोटी सजावट जैसी चीज़ों के लिए बंद करें जिन्हें उन्हें अनदेखा करना है।"
text "inspector.tip.navAgentHorde" "एक ही जगह जा रहे सभी के साथ एक साझा रास्ते पर चलता है। बड़े समूहों के लिए बहुत तेज़; वे बचने के बजाय एक-दूसरे को धकेलते हैं।"
text "inspector.navAreas.none" "कोई नहीं"
text "inspector.navAreas.all" "सभी एरिया"
text "projectSettings.category.navigation" "नेविगेशन"
text "projectSettings.navigationAreas" "नेविगेशन एरिया"
text "projectSettings.navigationAreasDescription" "ज़मीन के प्रकार जिन पर किरदार चलते हैं। ज़्यादा लागत से रास्ते एरिया से बचते हैं; 0 लागत उसे चलने योग्य नहीं रहने देती।"
text "projectSettings.navigationAreasSection" "नेविगेशन एरिया"
text "projectSettings.navAreaNameHint" "नए एरिया का नाम"
text "projectSettings.navAreaAdd" "एरिया जोड़ें"
text "projectSettings.crowdSection" "भीड़ का विवरण"
text "projectSettings.crowdDescription" "कैमरे से दूर के किरदार कम काम से चलते हैं, इसलिए एक फ़्रेम में उनमें से ज़्यादा समा जाते हैं।"
text "projectSettings.crowdNearDistance" "पूरा बचाव इतने तक (मी)"
text "projectSettings.crowdMidDistance" "सिर्फ़ दूरी इतने तक (मी)"
text "projectSettings.crowdFarPathInterval" "इससे दूर, रास्ते हर (कदम) पर अपडेट करें"
