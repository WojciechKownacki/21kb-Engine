text "inspector.tip.audioSource.attenuation" "Bagaimana bunyi menjadi perlahan apabila anda menjauhinya."
text "inspector.tip.audioSource.autoplay" "Mula dimainkan sebaik sahaja permainan bermula."
text "inspector.tip.audioSource.clearClip" "Mengalih keluar fail bunyi daripada sumber ini."
text "inspector.tip.audioSource.clip" "Fail bunyi yang dimainkan."
text "inspector.tip.audioSource.doppler" "Seberapa banyak nada berubah apabila bunyi melintas, seperti siren. 0 mematikannya."
text "inspector.tip.audioSource.enabled" "Menghidupkan atau mematikan bunyi ini."
text "inspector.tip.audioSource.loop" "Dimainkan semula dari awal apabila tamat."
text "inspector.tip.audioSource.maxDistance" "Melepasi jarak ini bunyi tidak menjadi perlahan lagi."
text "inspector.tip.audioSource.minDistance" "Sehingga jarak ini bunyi dimainkan pada kelantangan penuh."
text "inspector.tip.audioSource.mute" "Menyenyapkan bunyi tanpa menghentikannya."
text "inspector.tip.audioSource.outputBus" "Kumpulan pengadun tempat bunyi ini dimainkan."
text "inspector.tip.audioSource.pan" "Menggerakkan bunyi ke kiri (-1) atau ke kanan (1)."
text "inspector.tip.audioSource.pitch" "Seberapa tinggi atau rendah bunyinya. 1 biasa, 2 satu oktaf lebih tinggi."
text "inspector.tip.audioSource.rolloff" "Seberapa cepat bunyi menjadi perlahan mengikut jarak. Lebih tinggi lebih cepat."
text "inspector.tip.audioSource.spatial" "Bunyi datang dari objek ini: menjadi perlahan mengikut jarak dan bergerak ke kiri atau kanan."
text "inspector.tip.audioSource.spatialBlend" "0 memainkan bunyi sama rata di mana-mana, 1 meletakkannya sepenuhnya dalam dunia."
text "inspector.tip.audioSource.volume" "Seberapa kuat bunyinya. 0 senyap, 1 kelantangan penuh."
text "inspector.tip.camera.background" "Apa yang memenuhi skrin di belakang segalanya: warna, imej sebelumnya atau tiada."
text "inspector.tip.camera.cullingMask" "Lapisan yang dilukis kamera ini."
text "inspector.tip.camera.farClip" "Benda yang lebih jauh daripada ini tidak dilukis."
text "inspector.tip.camera.fieldOfView" "Seberapa luas kamera melihat. Sudut lebih besar menunjukkan lebih banyak adegan."
text "inspector.tip.camera.nearClip" "Benda yang lebih dekat daripada ini tidak dilukis."
text "inspector.tip.camera.primary" "Permainan dipaparkan melalui kamera ini."
text "inspector.tip.camera.projection" "Perspektif kelihatan seperti dunia sebenar. Ortografik tiada kedalaman, untuk permainan 2D dan pelan."
text "inspector.tip.camera.size" "Berapa banyak adegan yang muat dalam paparan, dari atas ke bawah."
text "inspector.tip.characterController.slopeLimit" "Cerun paling curam yang boleh didaki watak."
text "inspector.tip.characterController.stepOffset" "Anak tangga tertinggi yang didaki watak tanpa melompat."
text "inspector.tip.collider.bounciness" "Seberapa banyak benda melantun. 0 tidak melantun, 1 melantun sepenuhnya."
text "inspector.tip.collider.boxSize" "Lebar, tinggi dan kedalaman kotak."
text "inspector.tip.collider.center" "Mengalihkan bentuk dari tengah objek."
text "inspector.tip.collider.friction" "Seberapa kuat permukaan mencengkam. 0 licin seperti ais, 1 kasar."
text "inspector.tip.collider.isTrigger" "Mengesan benda yang melaluinya tetapi tidak menghalang."
text "inspector.tip.collider.meshAsset" "Mesh yang permukaannya digunakan sebagai bentuk."
text "inspector.tip.collider.shape" "Garis bentuk yang mengesan pelanggaran: kotak, sfera, kapsul atau bentuk mesh."
text "inspector.tip.joint.anchor" "Titik pada objek ini tempat sendi dipasang."
text "inspector.tip.joint.axis" "Arah sendi berputar atau menggelongsor."
text "inspector.tip.joint.breakForce" "Sendi putus jika ditolak lebih kuat daripada ini. Sifar tidak pernah putus."
text "inspector.tip.joint.connectedAnchor" "Titik pada objek lain, atau di dunia, tempat sendi dipasang."
text "inspector.tip.joint.direction" "Ke arah mana ia berputar, menggelongsor atau menunjuk. Klik untuk menukar."
text "inspector.tip.joint.enableLimit" "Menghalang sendi bergerak melepasi minimum dan maksimum."
text "inspector.tip.joint.length" "Panjang tali yang paling maksimum. Melepasinya tali menjadi tegang."
text "inspector.tip.joint.maxLimit" "Sudut atau jarak tertinggi yang boleh dicapai sendi."
text "inspector.tip.joint.minLimit" "Sudut atau jarak terendah yang boleh dicapai sendi."
text "inspector.tip.joint.motorForce" "Seberapa kuat motor menolak. Sifar mematikan motor."
text "inspector.tip.joint.motorSpeed" "Seberapa cepat motor menggerakkannya. 0 mematikan motor."
text "inspector.tip.joint.motorVelocity" "Kelajuan motor menggerakkan sendi."
text "inspector.tip.joint.opens" "Seberapa jauh ia terbuka ke setiap sisi dari kedudukan asal."
text "inspector.tip.joint.preset" "Tetapan sedia ada, seperti pintu atau tali. Pilih satu, kemudian ubah nilai yang anda mahu."
text "inspector.tip.joint.secondaryAxis" "Arah kedua yang menentukan bagaimana sendi diputar."
text "inspector.tip.joint.slides" "Seberapa jauh ia menggelongsor dari kedudukan asal."
text "inspector.tip.joint.spring" "Seberapa tegar spring. Sifar mengekalkan sendi tegar."
text "inspector.tip.joint.springDamper" "Seberapa cepat spring berhenti melantun."
text "inspector.tip.joint.swing" "Seberapa jauh sendi boleh condong, dalam darjah. 180 membiarkannya bebas."
text "inspector.tip.joint.tilt" "Seberapa jauh ia boleh condong ke mana-mana arah. 180 membiarkannya bebas."
text "inspector.tip.joint.twist" "Seberapa jauh ia boleh terpiuh ke setiap sisi."
text "inspector.tip.joint.type" "Cara kedua objek disambung: melekat, engsel, penggelongsor, tali dan lain-lain."
text "inspector.tip.light.castShadows" "Objek menghalang cahaya ini dan membuat bayang."
text "inspector.tip.light.color" "Warna cahaya."
text "inspector.tip.light.innerAngle" "Sudut pusat terang kon."
