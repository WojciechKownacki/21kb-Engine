text "projectSettings.antiAliasing" "Anti-Aliasing"
text "projectSettings.antiAliasingNone" "None"
text "projectSettings.antiAliasingTooltip" "Chooses exactly one AA path for the scene. TAA and FXAA run in post-process alongside your configured lighting path. MSAA multisamples the render target instead; on a Deferred-lit project it also forces per-sample Forward shading for this preview, since the G-buffer cannot be multisampled, so expect lower FPS than TAA/FXAA at the same resolution."
text "projectSettings.backendAuto" "Auto"
text "projectSettings.bloom" "Bloom"
text "projectSettings.bloomTooltip" "Adds a soft glow around bright pixels in the post-process chain. It depends on Post FX being enabled."
text "projectSettings.category.graphics" "Graphics"
text "projectSettings.category.inputs" "Inputs"
text "projectSettings.category.physics" "Physics"
text "projectSettings.gpuDriven" "GPU Driven"
text "projectSettings.gpuDrivenTooltip" "Enables runtime GPU-driven scene submission where supported. The renderer falls back when the selected backend lacks required features."
text "projectSettings.gpuVisibilityDiagnostics" "GPU Visibility Diagnostics"
text "projectSettings.graphicsSection" "GRAPHICS"
text "projectSettings.inputEnabled" "Input Enabled"
text "projectSettings.inputEnabledLabel" "Enabled"
text "projectSettings.inputEnabledTooltip" "Enables or disables project input processing. Disable it for scenes that should ignore gameplay input."
text "projectSettings.inputsSection" "INPUTS"
text "projectSettings.lightingDeferred" "Deferred"
text "projectSettings.lightingForward" "Forward"
text "projectSettings.lightingForwardPlus" "Forward+"
text "projectSettings.lightingPath" "Lighting Path"
text "projectSettings.lightingPathTooltip" "Chooses Forward or Deferred scene lighting for opaque geometry. Transparent objects still render in the forward transparent pass."
text "projectSettings.mappingContext" "Mapping Context"
text "projectSettings.mappingContextTooltip" "Selects the project-wide input mapping asset used by the runtime input system."
text "projectSettings.msaaOff" "Off"
text "projectSettings.msaaSamples" "MSAA Samples"
text "projectSettings.msaaSamplesTooltip" "Controls the hardware multisample count when Anti-Aliasing is set to MSAA. It is inactive for None, FXAA and TAA."
text "projectSettings.noAsset" "(None)"
text "projectSettings.physicsLayers" "Collision Layers Asset"
text "projectSettings.physicsLayersTooltip" "Selects the project-wide Physics Layers asset used to configure collision and query interactions at runtime."
text "projectSettings.physicsSection" "PHYSICS"
text "projectSettings.postProcess" "Post FX"
text "projectSettings.postProcessTooltip" "Master switch for scene post-processing such as anti-aliasing, bloom, selection outline and final composition."
text "projectSettings.renderBackend" "bgfx Backend"
text "projectSettings.renderBackendTooltip" "Chooses the rendering backend for the editor viewport. Changing it recreates renderer resources."
text "projectSettings.selectionOutline" "Selection Outline"
text "projectSettings.selectionOutlineTooltip" "Draws the editor outline around selected objects through the post-process chain. It depends on Post FX being enabled."
text "projectSettings.shadows" "Shadows"
text "projectSettings.shadowsTooltip" "Enables shadow submission for scene lighting. Turning it off reduces rendering cost while previewing layout or materials."
