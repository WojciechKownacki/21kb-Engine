if(NOT DEFINED BEFORE OR BEFORE STREQUAL "")
    message(FATAL_ERROR "BEFORE kernel report path is required")
endif()
if(NOT DEFINED AFTER OR AFTER STREQUAL "")
    message(FATAL_ERROR "AFTER kernel report path is required")
endif()
if(NOT DEFINED OUTPUT OR OUTPUT STREQUAL "")
    set(OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/ecs_kernel_report_comparison.json")
endif()

file(READ "${BEFORE}" before_json)
file(READ "${AFTER}" after_json)

string(JSON before_count LENGTH "${before_json}" kernels)
string(JSON after_count LENGTH "${after_json}" kernels)

set(regressions)
set(missing_after)
set(results_json "")

math(EXPR before_last "${before_count} - 1")
math(EXPR after_last "${after_count} - 1")

foreach(before_index RANGE 0 ${before_last})
    string(JSON before_kernel GET "${before_json}" kernels ${before_index} kernel)
    string(JSON before_backend GET "${before_json}" kernels ${before_index} backend)
    string(JSON before_avg GET "${before_json}" kernels ${before_index} time_ms_avg)
    string(JSON before_p95 GET "${before_json}" kernels ${before_index} time_ms_p95)
    string(JSON before_throughput GET "${before_json}" kernels ${before_index} throughput_elements_per_second)

    set(found_after FALSE)
    foreach(after_index RANGE 0 ${after_last})
        string(JSON after_kernel GET "${after_json}" kernels ${after_index} kernel)
        string(JSON after_backend GET "${after_json}" kernels ${after_index} backend)
        if(after_kernel STREQUAL before_kernel AND after_backend STREQUAL before_backend)
            set(found_after TRUE)
            string(JSON after_avg GET "${after_json}" kernels ${after_index} time_ms_avg)
            string(JSON after_p95 GET "${after_json}" kernels ${after_index} time_ms_p95)
            string(JSON after_throughput GET "${after_json}" kernels ${after_index} throughput_elements_per_second)

            if(after_avg GREATER before_avg)
                list(APPEND regressions "${before_kernel}/${before_backend}:time_ms_avg")
            endif()
            if(after_p95 GREATER before_p95)
                list(APPEND regressions "${before_kernel}/${before_backend}:time_ms_p95")
            endif()
            if(after_throughput LESS before_throughput)
                list(APPEND regressions "${before_kernel}/${before_backend}:throughput_elements_per_second")
            endif()

            string(APPEND results_json "    {\n")
            string(APPEND results_json "      \"kernel\": \"${before_kernel}\",\n")
            string(APPEND results_json "      \"backend\": \"${before_backend}\",\n")
            string(APPEND results_json "      \"before_time_ms_avg\": ${before_avg},\n")
            string(APPEND results_json "      \"after_time_ms_avg\": ${after_avg},\n")
            string(APPEND results_json "      \"before_time_ms_p95\": ${before_p95},\n")
            string(APPEND results_json "      \"after_time_ms_p95\": ${after_p95},\n")
            string(APPEND results_json "      \"before_throughput_elements_per_second\": ${before_throughput},\n")
            string(APPEND results_json "      \"after_throughput_elements_per_second\": ${after_throughput}\n")
            string(APPEND results_json "    }")
            if(NOT before_index EQUAL before_last)
                string(APPEND results_json ",")
            endif()
            string(APPEND results_json "\n")
            break()
        endif()
    endforeach()

    if(NOT found_after)
        list(APPEND missing_after "${before_kernel}/${before_backend}")
    endif()
endforeach()

get_filename_component(output_dir "${OUTPUT}" DIRECTORY)
if(NOT output_dir STREQUAL "")
    file(MAKE_DIRECTORY "${output_dir}")
endif()

set(regressions_json "")
list(LENGTH regressions regression_count)
if(regression_count GREATER 0)
    math(EXPR regression_last "${regression_count} - 1")
    foreach(index RANGE 0 ${regression_last})
        list(GET regressions ${index} regression)
        string(APPEND regressions_json "    \"${regression}\"")
        if(NOT index EQUAL regression_last)
            string(APPEND regressions_json ",")
        endif()
        string(APPEND regressions_json "\n")
    endforeach()
endif()

set(missing_after_json "")
list(LENGTH missing_after missing_after_count)
if(missing_after_count GREATER 0)
    math(EXPR missing_after_last "${missing_after_count} - 1")
    foreach(index RANGE 0 ${missing_after_last})
        list(GET missing_after ${index} missing)
        string(APPEND missing_after_json "    \"${missing}\"")
        if(NOT index EQUAL missing_after_last)
            string(APPEND missing_after_json ",")
        endif()
        string(APPEND missing_after_json "\n")
    endforeach()
endif()

file(WRITE "${OUTPUT}" "{\n")
file(APPEND "${OUTPUT}" "  \"before\": \"${BEFORE}\",\n")
file(APPEND "${OUTPUT}" "  \"after\": \"${AFTER}\",\n")
file(APPEND "${OUTPUT}" "  \"results\": [\n${results_json}  ],\n")
file(APPEND "${OUTPUT}" "  \"regressions\": [\n${regressions_json}  ],\n")
file(APPEND "${OUTPUT}" "  \"missing_after\": [\n${missing_after_json}  ]\n")
file(APPEND "${OUTPUT}" "}\n")

if(missing_after_count GREATER 0)
    message(FATAL_ERROR "ECS kernel report regression gate missing after results: ${missing_after}")
endif()
if(regression_count GREATER 0)
    message(FATAL_ERROR "ECS kernel report regression gate detected regressions: ${regressions}")
endif()

message(STATUS "ECS kernel report regression gate passed: ${OUTPUT}")
