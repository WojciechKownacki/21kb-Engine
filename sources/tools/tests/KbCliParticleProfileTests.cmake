if(NOT EXISTS "${CLI}")
    message(FATAL_ERROR "CLI executable is missing")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}")
get_filename_component(cli_dir "${CLI}" DIRECTORY)
foreach(profile dxbc dxil spirv glsl)
    if(NOT EXISTS "${cli_dir}/shaders/${profile}/cs_particle_gpu_collide.sc.bin")
        message(FATAL_ERROR "CLI runtime shader bundle is missing ${profile} particle motion")
    endif()
endforeach()
function(cli)
    execute_process(COMMAND "${CLI}" ${ARGN} WORKING_DIRECTORY "${TEST_ROOT}"
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 150)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "CLI ${ARGN} failed: ${code}\n${output}\n${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
endfunction()
function(profile frames)
    cli(vfx-profile --project "${project}" --effect /Game/Particles/Probe.kbvfx
        --backend d3d11 --warmup 0 --frames "${frames}" --samples 8 --require-gpu)
    set(report "${last_output}")
    foreach(key succeeded gpu_execution_observed readback_outside_measurement)
        string(JSON value GET "${report}" "${key}")
        if(NOT value)
            message(FATAL_ERROR "GPU profile did not prove ${key}: ${report}")
        endif()
    endforeach()
    string(JSON value GET "${report}" emitters 0 path)
    if(NOT value STREQUAL "gpu")
        message(FATAL_ERROR "GPU profile fell back: ${report}")
    endif()
    string(JSON value GET "${report}" emitters 0 cpu_render_record_count)
    string(JSON samples GET "${report}" frame_gpu sample_count)
    string(JSON records LENGTH "${report}" gpu_captures 0 raw_instance_records)
    string(JSON width LENGTH "${report}" gpu_captures 0 raw_instance_records 0)
    string(JSON fixed GET "${report}" fixed_step)
    math(EXPR expected_fixed "${frames} + 1")
    if(NOT value EQUAL 0 OR samples LESS 1 OR NOT records EQUAL 8 OR NOT width EQUAL 20 OR NOT fixed EQUAL expected_fixed)
        message(FATAL_ERROR "GPU profile counts or timing are invalid: ${report}")
    endif()
    foreach(key process_cpu_ns calling_thread_cpu_ns)
        string(JSON value GET "${report}" "${key}")
        if(NOT value MATCHES "^[0-9]+$")
            message(FATAL_ERROR "CPU time is unavailable: ${report}")
        endif()
    endforeach()
    string(JSON value GET "${report}" memory after_release gpu_emitter_requested_buffer_bytes)
    if(NOT value STREQUAL "0")
        message(FATAL_ERROR "GPU effect allocations were not released: ${report}")
    endif()
    set(last_report "${report}" PARENT_SCOPE)
endfunction()

# Unique per build: no shared temporary directory with other CLI suites.
string(RANDOM LENGTH 12 ALPHABET abcdef0123456789 suffix)
set(project "${TEST_ROOT}/ParticleProfile${suffix}")
cli(new --parent "${TEST_ROOT}" --name "ParticleProfile${suffix}" --template Empty)
cli(vfx-new --project "${project}" --name Probe
    --set effect.backendPolicy=GpuVisualPreferred --set effect.durationSeconds=10
    --set effect.emitter[0].maxParticles=256 --set effect.emitter[0].spawn.rate.key[0].value=60
    --set effect.emitter[0].spawn.lifetimeMin=5 --set effect.emitter[0].spawn.lifetimeMax=5
    --set effect.emitter[0].spawn.speedMin=4 --set effect.emitter[0].spawn.speedMax=4
    --set "effect.emitter[0].spawn.direction=1 0 0" --set effect.emitter[0].spawn.spreadDegrees=0
    --set effect.emitter[0].spawn.randomization=0)
cli(vfx-module-add --project "${project}" --effect /Game/Particles/Probe.kbvfx --emitter 1 --type CollisionPlane)
cli(vfx-set --project "${project}" --effect /Game/Particles/Probe.kbvfx
    --set "effect.emitter[0].module[2].payload.normal=-1 0 0"
    --set effect.emitter[0].module[2].payload.distance=-1
    --set effect.emitter[0].module[2].payload.killOnContact=true)
profile(8)
string(JSON size GET "${last_report}" gpu_captures 0 raw_instance_records 0 3)
if(NOT size GREATER 0)
    message(FATAL_ERROR "Particle was not alive before contact: ${last_report}")
endif()
profile(60)
foreach(lane RANGE 0 19)
    string(JSON value GET "${last_report}" gpu_captures 0 raw_instance_records 0 "${lane}")
    if(NOT value EQUAL 0)
        message(FATAL_ERROR "Contact death did not clear the actual render record: ${last_report}")
    endif()
endforeach()
cli(vfx-set --project "${project}" --effect /Game/Particles/Probe.kbvfx --set effect.emitter[0].module[2].enabled=false)
foreach(type Noise AxisRotation Attraction Noise AxisRotation Attraction)
    cli(vfx-module-add --project "${project}" --effect /Game/Particles/Probe.kbvfx --emitter 1 --type "${type}")
endforeach()
cli(vfx-set --project "${project}" --effect /Game/Particles/Probe.kbvfx
    --set effect.emitter[0].module[3].payload.strength=0.7 --set effect.emitter[0].module[3].payload.frequency=0.5
    --set "effect.emitter[0].module[4].payload.axis=0 1 0" --set effect.emitter[0].module[4].payload.degreesPerSecond=80
    --set "effect.emitter[0].module[5].payload.point=1 1 0" --set effect.emitter[0].module[5].payload.strength=3
    --set effect.emitter[0].module[5].payload.radius=4
    --set effect.emitter[0].module[6].payload.strength=1.3 --set effect.emitter[0].module[6].payload.frequency=2
    --set "effect.emitter[0].module[7].payload.axis=1 0 0" --set effect.emitter[0].module[7].payload.degreesPerSecond=60
    --set "effect.emitter[0].module[8].payload.point=-2 0 3" --set effect.emitter[0].module[8].payload.strength=2)
profile(60)
string(JSON count GET "${last_report}" gpu_captures 0 ordered_motion_operation_count)
if(NOT count EQUAL 6)
    message(FATAL_ERROR "Repeated mixed modules were lost: ${last_report}")
endif()
execute_process(COMMAND "${CLI}" vfx-profile --project "${project}" --effect /Game/Particles/Probe.kbvfx
    --warmup 0 --frames 8 --require-gpu --gpu-buffer-budget 224
    RESULT_VARIABLE code OUTPUT_VARIABLE report ERROR_VARIABLE error TIMEOUT 150)
if(code EQUAL 0)
    message(FATAL_ERROR "Rejected GPU allocation passed the strict profile: ${report}")
endif()
string(JSON reason GET "${report}" rejected_gpu_updates 0 reason)
string(JSON succeeded GET "${report}" succeeded)
string(JSON executed GET "${report}" gpu_execution_observed)
if(NOT reason STREQUAL "resource-creation" OR succeeded OR executed)
    message(FATAL_ERROR "CLI hid the actual GPU allocation rejection: ${report}")
endif()
cli(vfx-set --project "${project}" --effect /Game/Particles/Probe.kbvfx --set effect.backendPolicy=CpuDeterministic)
cli(vfx-profile --project "${project}" --effect /Game/Particles/Probe.kbvfx --warmup 0 --frames 8 --samples 8)
string(JSON path GET "${last_output}" emitters 0 path)
string(JSON reason GET "${last_output}" emitters 0 reason)
string(JSON capture_count LENGTH "${last_output}" gpu_captures)
if(NOT path STREQUAL "cpu" OR NOT reason STREQUAL "cpu-policy" OR NOT capture_count EQUAL 0)
    message(FATAL_ERROR "Explicit CPU selection was not preserved: ${last_output}")
endif()
execute_process(COMMAND "${CLI}" vfx-profile --project "${project}" --effect /Game/Particles/Probe.kbvfx
    --warmup 0 --frames 8 --require-gpu RESULT_VARIABLE code OUTPUT_VARIABLE report ERROR_VARIABLE error TIMEOUT 150)
if(code EQUAL 0)
    message(FATAL_ERROR "CPU fallback passed --require-gpu: ${report}")
endif()
string(JSON succeeded GET "${report}" succeeded)
if(succeeded)
    message(FATAL_ERROR "Failed strict GPU profile reported success")
endif()
cli(vfx-set --project "${project}" --effect /Game/Particles/Probe.kbvfx
    --set effect.emitter[0].maxParticles=2 --set effect.emitter[0].spawn.rate.key[0].value=600)
cli(vfx-profile --project "${project}" --effect /Game/Particles/Probe.kbvfx --warmup 0 --frames 8 --samples 8)
string(JSON live GET "${last_output}" emitters 0 cpu_render_record_count)
string(JSON capacity GET "${last_output}" emitters 0 rejected_by_capacity)
string(JSON spawn GET "${last_output}" emitters 0 rejected_by_spawn_budget)
string(JSON events GET "${last_output}" emitters 0 rejected_by_event_budget)
string(JSON dropped GET "${last_output}" emitters 0 dropped_particle_count)
string(JSON ceiling GET "${last_output}" configured_cpu_particle_limit)
string(JSON basis GET "${last_output}" configured_limit_basis)
if(NOT live EQUAL 2 OR NOT capacity EQUAL 10 OR NOT dropped EQUAL 10 OR NOT spawn EQUAL 0 OR NOT events EQUAL 0
    OR NOT ceiling EQUAL 262144 OR NOT basis STREQUAL "capacity ceiling, not measured throughput")
    message(FATAL_ERROR "CPU capacity overflow telemetry or configured-limit meaning is incorrect: ${last_output}")
endif()
file(WRITE "${project}/overflow-report.json" "${last_output}")
foreach(invalid IN ITEMS "--frames;0" "--frames;-1" "--frames;36001" "--samples;0" "--samples;4097"
    "--warmup;bad" "--backend;noop" "--unknown;1" "--quiet" "--frames;1;--frames;2" "--gpu-buffer-budget;-1" "--gpu-buffer-budget;18446744073709551615")
    execute_process(COMMAND "${CLI}" vfx-profile --project "${project}" --effect /Game/Particles/Probe.kbvfx ${invalid}
        RESULT_VARIABLE code OUTPUT_VARIABLE report ERROR_VARIABLE error TIMEOUT 10)
    if(code EQUAL 0)
        message(FATAL_ERROR "Invalid profile arguments succeeded: ${invalid}")
    endif()
endforeach()
message(STATUS "Actual D3D11 CLI routing, contact death, repeated modules, buffer readback, CPU/GPU timing and memory passed")
