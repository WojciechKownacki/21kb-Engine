if(NOT EXISTS "${CLI}" OR NOT DEFINED TEST_ROOT)
    message(FATAL_ERROR "CLI and test root are required")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}")
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(project "${TEST_ROOT}/AiSample${suffix}")

function(run_cli)
    execute_process(COMMAND "${CLI}" ${ARGN}
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 45)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "CLI failed (${code}): ${ARGN}\n${output}\n${error}")
    endif()
    set(cli_output "${output}" PARENT_SCOPE)
endfunction()

function(report)
    run_cli(run --project "${project}" --frames 30 --dt 0.0166667 --report ai)
    string(JSON schema GET "${cli_output}" schema)
    string(JSON succeeded GET "${cli_output}" succeeded)
    string(JSON provider GET "${cli_output}" provider_active)
    if(NOT schema STREQUAL "21kb.ai-decisions/v1" OR NOT succeeded OR NOT provider)
        message(FATAL_ERROR "AI report contract failed: ${cli_output}")
    endif()
    set(report_json "${cli_output}" PARENT_SCOPE)
endfunction()

# Each command loads and unloads the real provider DLL. This also catches
# runtime type metadata that accidentally points into an unloaded provider.
run_cli(new --parent "${TEST_ROOT}" --name "AiSample${suffix}" --template Empty)
report()
string(JSON count LENGTH "${report_json}" decisions)
if(NOT count EQUAL 0)
    message(FATAL_ERROR "Empty scene fabricated AI decisions")
endif()
run_cli(entity add --project "${project}" --name Actor)
run_cli(ai make --project "${project}" --entity Actor --preset Guard)
report()
string(JSON count LENGTH "${report_json}" decisions)
string(JSON enemy TYPE "${report_json}" decisions 0 enemy)
if(NOT count EQUAL 1 OR NOT enemy STREQUAL "NULL")
    message(FATAL_ERROR "Missing-target diagnostic is incorrect: ${report_json}")
endif()
run_cli(ai rule --project "${project}" --entity Actor --rule 1 --when Always --do Idle)
report()
string(JSON action GET "${report_json}" decisions 0 action)
string(JSON condition GET "${report_json}" decisions 0 condition)
string(JSON index GET "${report_json}" decisions 0 rule_index)
if(NOT action STREQUAL "Idle" OR NOT condition STREQUAL "Always" OR NOT index EQUAL 0)
    message(FATAL_ERROR "Reloaded rule was not selected: ${report_json}")
endif()
run_cli(component set --project "${project}" --entity Actor --type AIBrain --set enabled=false)
report()
string(JSON state GET "${report_json}" decisions 0 state)
string(JSON index GET "${report_json}" decisions 0 rule_index)
if(NOT state STREQUAL "disabled" OR NOT index EQUAL -1)
    message(FATAL_ERROR "Disabled brain retained an active decision: ${report_json}")
endif()
# A report must not claim success when a requested output cannot be saved.
execute_process(COMMAND "${CLI}" run --project "${project}" --frames 1
    --report ai --input-record "${project}"
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 45)
string(JSON succeeded GET "${output}" succeeded)
if(NOT code EQUAL 1 OR succeeded)
    message(FATAL_ERROR "AI report hid a recording write failure: ${code} ${output} ${error}")
endif()
message(STATUS "AI report and provider lifecycle checks passed")
