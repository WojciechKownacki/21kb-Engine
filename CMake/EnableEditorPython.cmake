set(KB_EDITOR_PYTHON_AVAILABLE FALSE)
if(WIN32 AND CMAKE_SIZEOF_VOID_P EQUAL 8 AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64)$")
    set(_kb_python_archive "${CMAKE_BINARY_DIR}/_deps/python-3.14.10.nupkg")
    set(_kb_python_root "${CMAKE_BINARY_DIR}/_deps/python-sdk-3.14.10/tools")
    set(_kb_python_hash "f54ba67c9951c3d773ea47d2bb095150c037c399f0423a968bcda22809241784")
    if(NOT EXISTS "${_kb_python_archive}")
        file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/_deps")
        file(DOWNLOAD "https://api.nuget.org/v3-flatcontainer/python/3.14.10/python.3.14.10.nupkg" "${_kb_python_archive}" EXPECTED_HASH "SHA256=${_kb_python_hash}" TLS_VERIFY ON)
    endif()
    file(SHA256 "${_kb_python_archive}" _kb_python_actual)
    if(NOT _kb_python_actual STREQUAL _kb_python_hash)
        message(FATAL_ERROR "Editor Python SDK archive hash mismatch")
    endif()
    if(NOT EXISTS "${_kb_python_root}/include/Python.h")
        file(ARCHIVE_EXTRACT INPUT "${_kb_python_archive}" DESTINATION "${CMAKE_BINARY_DIR}/_deps/python-sdk-3.14.10")
    endif()
    add_library(kb_editor_python SHARED IMPORTED)
    set_target_properties(kb_editor_python PROPERTIES IMPORTED_LOCATION "${_kb_python_root}/python314.dll" IMPORTED_IMPLIB "${_kb_python_root}/libs/python314.lib")
    target_link_libraries(kb_editor PRIVATE $<LINK_ONLY:kb_editor_python>)
    set_source_files_properties(src/authoring/EditorPythonRuntime.cpp PROPERTIES INCLUDE_DIRECTORIES "${_kb_python_root}/include" COMPILE_DEFINITIONS "KB_EDITOR_HAS_PYTHON=1")
    add_custom_command(TARGET kb_editor POST_BUILD
        COMMAND "${_kb_python_root}/python.exe" -I -S "${CMAKE_SOURCE_DIR}/scripts/prepare_editor_python.py" --sdk "${_kb_python_root}" --output "$<TARGET_FILE_DIR:kb_editor>"
        VERBATIM)
    set(KB_EDITOR_PYTHON_AVAILABLE TRUE)
endif()
