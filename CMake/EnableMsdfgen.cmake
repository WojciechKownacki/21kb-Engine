set(_kb_msdf_archive "${CMAKE_BINARY_DIR}/_deps/msdfgen-1.13.zip")
set(_kb_msdf_root "${CMAKE_BINARY_DIR}/_deps/msdfgen-src/msdfgen-1.13")
set(_kb_msdf_hash "e7b9cecb341873245aa77cfb113fc2e546799c308db25183541b8a9aefdbc916")
if(NOT EXISTS "${_kb_msdf_archive}")
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/_deps")
    file(DOWNLOAD "https://codeload.github.com/Chlumsky/msdfgen/zip/refs/tags/v1.13" "${_kb_msdf_archive}"
        EXPECTED_HASH "SHA256=${_kb_msdf_hash}" TLS_VERIFY ON)
endif()
file(SHA256 "${_kb_msdf_archive}" _kb_msdf_actual_hash)
if(NOT _kb_msdf_actual_hash STREQUAL _kb_msdf_hash)
    message(FATAL_ERROR "MSDF generator archive hash mismatch")
endif()
if(NOT EXISTS "${_kb_msdf_root}/msdfgen.h")
    file(ARCHIVE_EXTRACT INPUT "${_kb_msdf_archive}" DESTINATION "${CMAKE_BINARY_DIR}/_deps/msdfgen-src")
endif()
set(MSDFGEN_CORE_ONLY ON CACHE BOOL "Build the outline distance generator" FORCE)
set(MSDFGEN_BUILD_STANDALONE OFF CACHE BOOL "No standalone generator" FORCE)
set(MSDFGEN_USE_VCPKG OFF CACHE BOOL "Use engine dependencies" FORCE)
set(MSDFGEN_USE_OPENMP OFF CACHE BOOL "Use the engine job model" FORCE)
set(MSDFGEN_USE_SKIA OFF CACHE BOOL "Use authored font outlines" FORCE)
set(MSDFGEN_INSTALL OFF CACHE BOOL "Use the engine install contract" FORCE)
set(MSDFGEN_DYNAMIC_RUNTIME ON CACHE BOOL "Use the engine runtime library" FORCE)
function(kb_add_msdfgen_core)
    set(BUILD_SHARED_LIBS OFF)
    add_subdirectory("${_kb_msdf_root}" "${CMAKE_BINARY_DIR}/_deps/msdfgen-build" EXCLUDE_FROM_ALL)
endfunction()
kb_add_msdfgen_core()
