set(_kb_csg_archive "${CMAKE_BINARY_DIR}/_deps/manifold-3.5.4.zip")
set(_kb_csg_root "${CMAKE_BINARY_DIR}/_deps/manifold-src/manifold-3.5.4")
set(_kb_csg_hash "5efa97c2cd9673294be10fd6725dfc5bcc43b7fd5dd4a115a6d1b48cad1788bb")
if(NOT EXISTS "${_kb_csg_archive}")
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/_deps")
    file(DOWNLOAD "https://codeload.github.com/elalish/manifold/zip/refs/tags/v3.5.4" "${_kb_csg_archive}" EXPECTED_HASH "SHA256=${_kb_csg_hash}" TLS_VERIFY ON)
endif()
file(SHA256 "${_kb_csg_archive}" _kb_csg_actual_hash)
if(NOT _kb_csg_actual_hash STREQUAL _kb_csg_hash)
    message(FATAL_ERROR "CSG geometry archive hash mismatch")
endif()
if(NOT EXISTS "${_kb_csg_root}/CMakeLists.txt")
    file(ARCHIVE_EXTRACT INPUT "${_kb_csg_archive}" DESTINATION "${CMAKE_BINARY_DIR}/_deps/manifold-src")
endif()
foreach(option IN ITEMS CROSS_SECTION PAR TEST PYBIND CBIND JSBIND DOWNLOADS DEBUG TIMING)
    set(MANIFOLD_${option} OFF CACHE BOOL "Build only the serial solid geometry core" FORCE)
endforeach()
function(kb_add_csg_geometry)
    set(BUILD_SHARED_LIBS OFF)
    add_subdirectory("${_kb_csg_root}" "${CMAKE_BINARY_DIR}/_deps/manifold-build" EXCLUDE_FROM_ALL)
endfunction()
kb_add_csg_geometry()
set_target_properties(manifold PROPERTIES OUTPUT_NAME kb_csg_geometry ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}")
