# Generates what LuaJIT's own build generates before its C sources can be compiled for a target that is not the machine
# running the build (Android, or Linux through the normal CMake toolchain): the VM in assembler for the target, and the
# headers the library sources include. This does what LuaJIT's Makefile does: build the two host tools (minilua, buildvm)
# with the compiler of the host, ask the target compiler which architecture variant it builds for, run dynasm over the
# assembler template and buildvm over the library sources. Run by the build as
#   cmake -DLJ_SRC=<luajit>/src -DLJ_GEN=<output directory> -DLJ_TARGET_CC=<target C compiler> "-DLJ_TARGET_FLAGS=<flags>"
#         -DLJ_TARGET_OS=Linux -P GenerateLuaJitVm.cmake
# The host compiler is the C compiler of the host: cc on Linux and macOS, the Visual Studio tools on Windows (found
# through KB_BUILD_TOOLS or the environment).

foreach(variable LJ_SRC LJ_GEN LJ_TARGET_CC)
    if(NOT DEFINED ${variable})
        message(FATAL_ERROR "GenerateLuaJitVm.cmake needs -D${variable}=...")
    endif()
endforeach()
if(NOT DEFINED LJ_TARGET_OS)
    set(LJ_TARGET_OS Linux)
endif()
separate_arguments(LJ_TARGET_FLAGS_LIST NATIVE_COMMAND "${LJ_TARGET_FLAGS}")
file(MAKE_DIRECTORY ${LJ_GEN}/host ${LJ_GEN}/jit)

# -- The architecture the target compiler builds for (the Makefile's TARGET_TESTARCH) ----------------------------------
execute_process(
    COMMAND ${LJ_TARGET_CC} ${LJ_TARGET_FLAGS_LIST} -E ${LJ_SRC}/lj_arch.h -dM
    OUTPUT_VARIABLE testarch RESULT_VARIABLE testarch_result ERROR_VARIABLE testarch_error)
if(NOT testarch_result EQUAL 0)
    message(FATAL_ERROR "The target compiler could not describe its architecture: ${testarch_error}")
endif()

function(lj_has what result)
    string(FIND "${testarch}" "${what}" position)
    if(position EQUAL -1)
        set(${result} OFF PARENT_SCOPE)
    else()
        set(${result} ON PARENT_SCOPE)
    endif()
endfunction()

lj_has("LJ_TARGET_X64 " is_x64)
lj_has("LJ_TARGET_X86 " is_x86)
lj_has("LJ_TARGET_ARM64 " is_arm64)
lj_has("LJ_TARGET_ARM " is_arm)
if(is_x64)
    set(arch x64)
elseif(is_arm64)
    set(arch arm64)
elseif(is_x86)
    set(arch x86)
elseif(is_arm)
    set(arch arm)
else()
    message(FATAL_ERROR "LuaJIT has no VM for the architecture of ${LJ_TARGET_CC}")
endif()
set(dasm_arch ${arch})
set(dasm_flags "")
string(TOUPPER "${LJ_TARGET_OS}" os_upper)
set(host_defines -DLUAJIT_TARGET=LUAJIT_ARCH_${arch} -DLUAJIT_OS=LUAJIT_OS_${os_upper})

lj_has("LJ_LE 1" little_endian)
if(little_endian)
    list(APPEND dasm_flags -D ENDIAN_LE)
else()
    list(APPEND dasm_flags -D ENDIAN_BE)
endif()
lj_has("LJ_ARCH_BITS 64" bits64)
if(bits64)
    list(APPEND dasm_flags -D P64)
endif()
lj_has("LJ_HASJIT 1" has_jit)
if(has_jit)
    list(APPEND dasm_flags -D JIT)
endif()
lj_has("LJ_HASFFI 1" has_ffi)
if(has_ffi)
    list(APPEND dasm_flags -D FFI)
endif()
lj_has("LJ_DUALNUM 1" dualnum)
if(dualnum)
    list(APPEND dasm_flags -D DUALNUM)
endif()
lj_has("LJ_ARCH_HASFPU 1" has_fpu)
if(has_fpu)
    list(APPEND dasm_flags -D FPU)
    list(APPEND host_defines -DLJ_ARCH_HASFPU=1)
else()
    list(APPEND host_defines -DLJ_ARCH_HASFPU=0)
endif()
lj_has("LJ_ABI_SOFTFP 1" softfp)
if(softfp)
    list(APPEND host_defines -DLJ_ABI_SOFTFP=1)
else()
    list(APPEND dasm_flags -D HFABI)
    list(APPEND host_defines -DLJ_ABI_SOFTFP=0)
endif()
lj_has("LJ_NO_UNWIND 1" no_unwind)
if(no_unwind)
    list(APPEND dasm_flags -D NO_UNWIND)
    list(APPEND host_defines -DLUAJIT_NO_UNWIND)
endif()
lj_has("LJ_ABI_PAUTH 1" pauth)
if(pauth)
    list(APPEND dasm_flags -D PAUTH)
    list(APPEND host_defines -DLJ_ABI_PAUTH=1)
endif()
lj_has("LJ_ABI_BRANCH_TRACK 1" branch_track)
if(branch_track)
    list(APPEND dasm_flags -D BRANCH_TRACK)
    list(APPEND host_defines -DLJ_ABI_BRANCH_TRACK=1)
endif()
lj_has("LJ_ABI_SHADOW_STACK 1" shadow_stack)
if(shadow_stack)
    list(APPEND dasm_flags -D SHADOW_STACK)
    list(APPEND host_defines -DLJ_ABI_SHADOW_STACK=1)
endif()
if(testarch MATCHES "#define LJ_ARCH_VERSION ([0-9]+)")
    list(APPEND dasm_flags -D VER=${CMAKE_MATCH_1})
endif()
if(LJ_TARGET_OS STREQUAL "Windows")
    list(APPEND dasm_flags -D WIN)
endif()
if(is_x64)
    lj_has("LJ_FR2 1" fr2)
    if(NOT fr2)
        set(dasm_arch x86)
    endif()
endif()

# -- The host tools ----------------------------------------------------------------------------------------------------
# One command line per tool, run with the compiler of the host.
if(CMAKE_HOST_WIN32)
    # Visual Studio tools: through the environment when it is set up, else through vcvars64.bat.
    find_program(host_cl cl)
    set(host_prefix "")
    if(NOT host_cl)
        set(tools "$ENV{KB_BUILD_TOOLS}")
        if(tools STREQUAL "")
            set(tools "C:/BuildTools")
        endif()
        set(vcvars "${tools}/VC/Auxiliary/Build/vcvars64.bat")
        if(NOT EXISTS "${vcvars}")
            message(FATAL_ERROR "No host C compiler for the LuaJIT tools: run the build from a Visual Studio environment or set KB_BUILD_TOOLS")
        endif()
        file(TO_NATIVE_PATH "${vcvars}" vcvars_native)
        set(host_prefix cmd /c call "${vcvars_native}" >nul &&)
    endif()
    function(lj_host_run)
        # The arguments are one command for cmd.
        string(REPLACE ";" " " command "${ARGN}")
        file(WRITE ${LJ_GEN}/host/run.bat "@echo off\r\n")
        if(host_prefix)
            file(APPEND ${LJ_GEN}/host/run.bat "call \"${vcvars_native}\" >nul\r\n")
        endif()
        file(APPEND ${LJ_GEN}/host/run.bat "${command}\r\n")
        execute_process(COMMAND cmd /c ${LJ_GEN}/host/run.bat WORKING_DIRECTORY ${LJ_GEN}/host RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "LuaJIT host tool step failed: ${command}\n${out}\n${err}")
        endif()
    endfunction()
    file(TO_NATIVE_PATH ${LJ_SRC} src_native)
    file(TO_NATIVE_PATH ${LJ_GEN} gen_native)
    lj_host_run(cl /nologo /O2 /D_CRT_SECURE_NO_DEPRECATE "/Fo${gen_native}\\host\\" "/Fe${gen_native}\\host\\minilua.exe" "${src_native}\\host\\minilua.c")
    set(minilua ${LJ_GEN}/host/minilua.exe)
else()
    find_program(host_cc NAMES cc gcc clang REQUIRED)
    execute_process(COMMAND ${host_cc} -O2 -o ${LJ_GEN}/host/minilua ${LJ_SRC}/host/minilua.c -lm RESULT_VARIABLE result ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "minilua did not build: ${err}")
    endif()
    set(minilua ${LJ_GEN}/host/minilua)
endif()

function(lj_run)
    execute_process(COMMAND ${ARGN} WORKING_DIRECTORY ${LJ_SRC} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "LuaJIT generation step failed: ${ARGN}\n${out}\n${err}")
    endif()
endfunction()

# The architecture header for buildvm, and the version header.
lj_run(${minilua} ${LJ_SRC}/../dynasm/dynasm.lua -LN ${dasm_flags} -o ${LJ_GEN}/host/buildvm_arch.h ${LJ_SRC}/vm_${dasm_arch}.dasc)
if(EXISTS ${LJ_SRC}/../.relver)
    file(READ ${LJ_SRC}/../.relver relver)
    file(WRITE ${LJ_GEN}/luajit_relver.txt "${relver}")
else()
    file(WRITE ${LJ_GEN}/luajit_relver.txt "0\n")
endif()
lj_run(${minilua} ${LJ_SRC}/host/genversion.lua ${LJ_SRC}/luajit_rolling.h ${LJ_GEN}/luajit_relver.txt ${LJ_GEN}/luajit.h)

if(CMAKE_HOST_WIN32)
    set(defines "")
    foreach(define IN LISTS host_defines)
        string(REGEX REPLACE "^-D" "/D" define "${define}")
        list(APPEND defines "${define}")
    endforeach()
    lj_host_run(cl /nologo /O2 /D_CRT_SECURE_NO_DEPRECATE ${defines} "/I${src_native}" "/I${src_native}\\..\\dynasm" "/I${gen_native}\\host"
        "/Fo${gen_native}\\host\\" "/Fe${gen_native}\\host\\buildvm.exe" "${src_native}\\host\\buildvm.c" "${src_native}\\host\\buildvm_asm.c"
        "${src_native}\\host\\buildvm_peobj.c" "${src_native}\\host\\buildvm_lib.c" "${src_native}\\host\\buildvm_fold.c")
    set(buildvm ${LJ_GEN}/host/buildvm.exe)
else()
    execute_process(
        COMMAND ${host_cc} -O2 ${host_defines} -I${LJ_SRC} -I${LJ_SRC}/../dynasm -I${LJ_GEN}/host -o ${LJ_GEN}/host/buildvm
            ${LJ_SRC}/host/buildvm.c ${LJ_SRC}/host/buildvm_asm.c ${LJ_SRC}/host/buildvm_peobj.c ${LJ_SRC}/host/buildvm_lib.c ${LJ_SRC}/host/buildvm_fold.c -lm
        RESULT_VARIABLE result ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "buildvm did not build: ${err}")
    endif()
    set(buildvm ${LJ_GEN}/host/buildvm)
endif()

# -- The VM and the headers --------------------------------------------------------------------------------------------
set(libraries lib_base.c lib_math.c lib_bit.c lib_string.c lib_table.c lib_io.c lib_os.c lib_package.c lib_debug.c lib_jit.c lib_ffi.c lib_buffer.c)
if(LJ_TARGET_OS STREQUAL "Windows")
    set(vm_mode peobj)
    set(vm_output ${LJ_GEN}/lj_vm.obj)
else()
    set(vm_mode elfasm)
    set(vm_output ${LJ_GEN}/lj_vm.S)
endif()
lj_run(${buildvm} -m ${vm_mode} -o ${vm_output})
lj_run(${buildvm} -m bcdef -o ${LJ_GEN}/lj_bcdef.h ${libraries})
lj_run(${buildvm} -m ffdef -o ${LJ_GEN}/lj_ffdef.h ${libraries})
lj_run(${buildvm} -m libdef -o ${LJ_GEN}/lj_libdef.h ${libraries})
lj_run(${buildvm} -m recdef -o ${LJ_GEN}/lj_recdef.h ${libraries})
lj_run(${buildvm} -m vmdef -o ${LJ_GEN}/jit/vmdef.lua ${libraries})
lj_run(${buildvm} -m folddef -o ${LJ_GEN}/lj_folddef.h lj_opt_fold.c)
