# Keep the dependency's target, platform options and link interfaces while
# enabling its bundled Vorbis decoder in the implementation translation unit.
get_target_property(kb_miniaudio_sources miniaudio SOURCES)
set(kb_miniaudio_wrapped_sources)
set(kb_miniaudio_replaced FALSE)
foreach(kb_miniaudio_source IN LISTS kb_miniaudio_sources)
    if(kb_miniaudio_source STREQUAL "miniaudio.c")
        list(APPEND kb_miniaudio_wrapped_sources
            "${CMAKE_CURRENT_SOURCE_DIR}/sources/plugins/audio_miniaudio/runtime/MiniaudioImplementation.c")
        set(kb_miniaudio_replaced TRUE)
    elseif(IS_ABSOLUTE "${kb_miniaudio_source}")
        list(APPEND kb_miniaudio_wrapped_sources "${kb_miniaudio_source}")
    else()
        list(APPEND kb_miniaudio_wrapped_sources "${CMAKE_CURRENT_SOURCE_DIR}/third_party/miniaudio/${kb_miniaudio_source}")
    endif()
endforeach()
if(NOT kb_miniaudio_replaced)
    message(FATAL_ERROR "The miniaudio implementation source could not be configured")
endif()
set_property(TARGET miniaudio PROPERTY SOURCES "${kb_miniaudio_wrapped_sources}")
unset(kb_miniaudio_source)
unset(kb_miniaudio_sources)
unset(kb_miniaudio_wrapped_sources)
unset(kb_miniaudio_replaced)
