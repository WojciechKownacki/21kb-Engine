{
  "name": "FirstScene",
  "platform": "Windows.x64",
  "steps": [
    [
      "{CLI}",
      "new",
      "--parent",
      "{WORKSPACE}",
      "--name",
      "SampleScene",
      "--template",
      "Empty"
    ],
    [
      "{CLI}",
      "entity",
      "add",
      "--project",
      "{PROJECT}",
      "--create",
      "Camera",
      "--name",
      "MainCamera",
      "--position",
      "0,3.2,-8.5"
    ],
    [
      "{CLI}",
      "component",
      "set",
      "--project",
      "{PROJECT}",
      "--entity",
      "MainCamera",
      "--type",
      "Transform",
      "--set",
      "localRotation.x=0.12187",
      "--set",
      "localRotation.w=0.99255"
    ],
    [
      "{CLI}",
      "entity",
      "add",
      "--project",
      "{PROJECT}",
      "--create",
      "Directional Light",
      "--name",
      "Sun"
    ],
    [
      "{CLI}",
      "entity",
      "add",
      "--project",
      "{PROJECT}",
      "--create",
      "Environment",
      "--name",
      "Environment"
    ],
    [
      "{CLI}",
      "entity",
      "add",
      "--project",
      "{PROJECT}",
      "--create",
      "Plane",
      "--name",
      "Floor"
    ],
    [
      "{CLI}",
      "entity",
      "add",
      "--project",
      "{PROJECT}",
      "--create",
      "Cube",
      "--name",
      "Cube",
      "--position",
      "0,0.5,0"
    ],
    [
      "{CLI}",
      "script-new",
      "--project",
      "{PROJECT}",
      "--name",
      "FirstScript",
      "--language",
      "lua"
    ],
    [
      "{CLI}",
      "scene-attach",
      "--project",
      "{PROJECT}",
      "--scene",
      "Assets/Scenes/Main.21kbscene",
      "--node",
      "Cube",
      "--script",
      "/Game/Scripts/FirstScript.lua"
    ],
    [
      "{CLI}",
      "validate",
      "{PROJECT}/Assets/Scripts/FirstScript.lua"
    ],
    [
      "{CLI}",
      "run",
      "--project",
      "{PROJECT}",
      "--frames",
      "10"
    ],
    [
      "{PLAYER}",
      "--project={PROJECT}",
      "--headless",
      "--frames=8",
      "--renderer=d3d11",
      "--width=640",
      "--height=360",
      "--screenshot-frame=6",
      "--screenshot-file={WORKSPACE}/preview.png"
    ],
    [
      "{CLI}",
      "keys",
      "generate",
      "--out",
      "{WORKSPACE}/Tutorial.kbkey"
    ],
    [
      "{PYTHON}",
      "{ENGINE}/scripts/package_game.py",
      "--project",
      "{PROJECT}/SampleScene.21kbproject",
      "--target",
      "Windows.x64",
      "--configuration",
      "Release",
      "--output",
      "{WORKSPACE}/Export",
      "--engine-root",
      "{ENGINE}",
      "--build-root",
      "{BUILD}",
      "--product-name",
      "SampleScene",
      "--publisher",
      "Sample Author",
      "--version",
      "1.0.0",
      "--executable-name",
      "SampleScene",
      "--product-id",
      "sample.first-scene",
      "--signing-key",
      "{WORKSPACE}/Tutorial.kbkey"
    ]
  ]
}
